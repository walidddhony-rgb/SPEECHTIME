# Include README files
include README.md
include README_ar.md
include CHANGELOG.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include LICENSE
include requirements.txt
include pyproject.toml
include setup.py
include MANIFEST.in

# Include configuration files
include .gitignore
include .flake8
include .editorconfig

# Include source code
recursive-include src *.py
recursive-exclude src __pycache__
recursive-exclude src *.pyc

# Include examples
recursive-include examples *.py
recursive-include examples *.csv
recursive-exclude examples __pycache__

# Include tests
recursive-include tests *.py
recursive-exclude tests __pycache__

# Include documentation
recursive-include docs *.md
recursive-exclude docs _build

# Include GUI
recursive-include gui *.py
recursive-exclude gui __pycache__

# Include GitHub workflows
recursive-include .github *.yml
recursive-include .github *.yaml

# Exclude test and build artifacts
exclude *.egg-info
exclude .pytest_cache
exclude .coverage
exclude htmlcov
exclude *.so
exclude *.pyd