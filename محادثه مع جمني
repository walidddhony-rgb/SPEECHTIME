        lbl_log = ctk.CTkLabel(log_subframe, text="📊 سجل المعالجة ومراقبة الانكماش اللحظي:", font=ctk.CTkFont(size=12, weight="bold"), text_color="#94A3B8")
        lbl_log.pack(anchor="w", padx=10, pady=5)
        
