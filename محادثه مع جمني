    final_knowledge_base = {}
    cluster_counter = 0
    
    # عداد العينات المقتطعة التراكمي الرياضي
    accumulated_deleted_samples = 0
    
    x = np.copy(ternary_signal)
    chunk_buffer_limit = segment_len * 20 # الحفاظ على نطاق موازي محمي وآمن للـ RAM
    
