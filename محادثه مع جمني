def butter_lowpass_filter(data, cutoff, fs, order=4):
    nyq = 0.5 * fs
    normal_cutoff = cutoff / nyq
    b, a = butter(order, normal_cutoff, btype='low', analog=False)
    return filtfilt(b, a, data)

def extract_pure_word_signal(audio_path):
    """
    تقنية تنظيف الإشارة وعزل المتحدث:
    تقوم بتصفية الموجات وحذف تردد الحبال الصوتية البشري للتركيز على طاقة الكلمة وفونيماتها.
    """
    sr, x = wavfile.read(audio_path)
    x = x.astype(np.float64)
    
    # تحويل هيلبرت للحصول على الغلاف التحليلي اللحظي (القمم العليا)
    analytic_signal = hilbert(x)
    amplitude_envelope = np.abs(analytic_signal)
    
    # الفلتر المنخفض (25 هرتز) لاصطياد حركة أعضاء النطق فقط وإهمال الـ Pitch البشري
    word_structure_signal = butter_lowpass_filter(amplitude_envelope, cutoff=25, fs=sr, order=4)
    word_structure_signal += abs(word_structure_signal.min())
    
    # تطبيق النظام الثلاثي التغيري (0, 1, 2) بناءً على حركة الطاقة
    x1 = np.sign(np.roll(word_structure_signal, -1) - word_structure_signal)
    ternary_signal = (x1 + 1).astype(np.int8)
    
    return ternary_signal, sr

def ternary_to_fixed_decimal(ternary_slice, fixed_length=24):
    """تحويل مصفوفة الفونيم الثلاثية إلى رقم عشري ثابت (بصمة هيكلية هجينة)"""
    if len(ternary_slice) == 0:
        return 0
    indices = np.linspace(0, len(ternary_slice) - 1, fixed_length, dtype=int)
    normalized_ternary = ternary_slice[indices]
    
    decimal_value = 0
    for power, digit in enumerate(reversed(normalized_ternary)):
        decimal_value += int(digit) * (3 ** power)
    return decimal_value

def parse_speechscribe_times(txt_path):
    """محلل نصوص الأوقات المستخرجة من مشروع SpeechScribe الأصلي"""
    phonemes_data = []
    pattern = r"\[(\d+):(\d+):(\d+),(\d+)\]\s+time\s+(.+)"
    if not os.path.exists(txt_path):
        return []
    with open(txt_path, 'r', encoding='utf-8') as f:
        for line in f:
            match = re.match(pattern, line.strip())
            if match:
                hrs, mins, secs, ms, phoneme = match.groups()
                total_seconds = int(hrs)*3600 + int(mins)*60 + int(secs) + int(ms)/1000.0
                phonemes_data.append((total_seconds, phoneme.strip()))
    return phonemes_data

