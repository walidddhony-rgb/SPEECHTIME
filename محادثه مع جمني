import numpy as np

def process_relative_sequence(seq):
    # حساب الفروق المتتالية بين كل عنصر والتالي (النسبية الحركية)
    diff = np.roll(seq, -1) - seq
    # نأخذ الإشارة فقط (صعود +1، ثبات 0، هبوط -1)
    sign_diff = np.sign(diff)[:-1] # استبعاد العنصر الأخير الناتج عن الـ roll
    return sign_diff

# المتحدث الأول (قيم منخفضة)
speaker_1 = np.array([1, 2, 3, 4, 5])

# المتحدث الثاني (قيم مرتفعة)
speaker_2 = np.array([9, 10, 11, 12, 13])

# معالجة السلسلتين
result_1 = process_relative_sequence(speaker_1)
result_2 = process_relative_sequence(speaker_2)

print(f"📊 إشارة المتحدث الأول الحركية: {result_1}")
print(f"📊 إشارة المتحدث الثاني الحركية: {result_2}")
print(f"🎯 هل الإشارتان متطابقتان تماماً في عين النظام؟ {np.array_equal(result_1, result_2)}")
