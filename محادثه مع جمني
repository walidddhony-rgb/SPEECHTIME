import os
import numpy as np
from scipy.io import wavfile
from scipy.signal import hilbert, butter, filtfilt

def butter_lowpass_filter(data, cutoff, fs, order=4):
    """مرشح لتنعيم غلاف الطاقة وعزل ترددات الحبال الصوتية المرتفعة"""
    nyq = 0.5 * fs
    normal_cutoff = cutoff / nyq
    b, a = butter(order, normal_cutoff, btype='low', analog=False)
    return filtfilt(b, a, data)

def extract_pure_200ms_envelope(audio_path):
    """عزل نبرة المتحدث وتحويل الإشارة لنظام ثلاثي حركي لحظي (0, 1, 2)"""
    sr, x = wavfile.read(audio_path)
    if len(x.shape) > 1:
        x = x[:, 0]
    x = x.astype(np.float64)
    x += abs(x.min())
    
    analytic_signal = hilbert(x)
    amplitude_envelope = np.abs(analytic_signal)
    
    word_structure_signal = butter_lowpass_filter(amplitude_envelope, cutoff=25, fs=sr, order=4)
    word_structure_signal += abs(word_structure_signal.min())
    
    diff_signal = np.sign(np.roll(word_structure_signal, -1) - word_structure_signal)
    ternary_signal = (diff_signal + 1).astype(np.int8)
    
    return ternary_signal, sr

def run_125ms_shrinkage_core(audio_path, similarity_threshold=0.85, log_callback=None, result_callback=None):
    """
    النواة التناقصية المتسارعة الآمنة للذاكرة العشوائية (RAM Optimized):
    - الطول مثبت بدقة عند 200ms بناءً على طلبك.
    - المعالجة تتم عبر كتل زمنية متحركة لضمان استقرار الأجهزة مع الملفات التي تتجاوز الساعات.
    """
    if not os.path.exists(audio_path):
        if log_callback: log_callback("❌ خطأ: لم يتم العثور على ملف الصوت!")
        return {}

    ternary_signal, sr = extract_pure_200ms_envelope(audio_path)
    initial_length = len(ternary_signal)
    
    # 📏 تثبيت النافذة بدقة عند 200 ملي ثانية (حوالي 3200 سامبل عند 16kHz)
    segment_len = int((200 * sr) // 1000)
    
    if log_callback:
        log_callback(f"🎬 إجمالي عينات الملف البدائية: {initial_length:,} سامبل.")
        log_callback(f"📐 طول نافذة الـ 200ms الثابتة: {segment_len:,} سامبل.")
        log_callback("🛡️  تم تفعيل وضع حماية الذاكرة العشوائية للملفات الكبيرة بنجاح.")
        log_callback("-" * 50)

    final_knowledge_base = {}
    cluster_counter = 0
    
    global_indices = np.arange(initial_length, dtype=np.int64)
    x = np.copy(ternary_signal)
    
    # تحديد طول "الكتلة المتحركة لحماية الذاكرة" (مثلاً نافذة تتسع لـ 50 حرفاً متتالياً كحد أقصى للـ np.tile في الدورة الفردية)
    # هذا يمنع الـ RAM من الانهيار تماماً ويحافظ على سرعة المعالجة الموازية
    chunk_buffer_limit = segment_len * 50 
    
    while len(x) >= segment_len:
        segment = x[:segment_len]
        segment_energy = np.sum(segment * segment)
        
        if segment_energy == 0:
            x = x[segment_len:]
            global_indices = global_indices[segment_len:]
            continue
            
        cluster_name = f"Phoneme_Cluster_{cluster_counter}"
        keep_mask = np.ones(len(x), dtype=bool)
        matched_true_positions = []
        
        # حصر نطاق معالجة الـ np.tile الحالي في مساحة آمنة لتوفير الذاكرة
        current_processing_limit = min(len(x), chunk_buffer_limit)
        
        for shift in range(segment_len):
            available_len = current_processing_limit - shift
            num_blocks = available_len // segment_len
            truncated_len = num_blocks * segment_len
            
            if num_blocks == 0:
                continue
                
            # بناء القالب المكرر المتوازي في نطاق الذاكرة المحمية الآمنة
            tiled_pattern = np.tile(segment, num_blocks)
            x_slice = x[shift : shift + truncated_len]
            
            multiplication_result = x_slice * tiled_pattern
            reshaped_matrix = multiplication_result.reshape(num_blocks, segment_len)
            
            block_sums = np.sum(reshaped_matrix, axis=1)
            block_probabilities = block_sums / segment_energy
            
            matched_block_indices = np.where(block_probabilities >= similarity_threshold)
            
            for b_idx in matched_block_indices[0]: # تم إصلاح قراءة الـ tuple هنا أيضاً بدقة
                actual_start_pos = int(shift + (b_idx * segment_len))
                actual_end_pos = int(actual_start_pos + segment_len)
                
                keep_mask[actual_start_pos:actual_end_pos] = False
                
                true_sample_index = global_indices[actual_start_pos]
                matched_true_positions.append(true_sample_index / sr)
                
        # --- خطوة الحذف الفعلي والانكماش الديناميكي المتسارع ---
        if len(matched_true_positions) > 0:
            x = x[keep_mask] 
            global_indices = global_indices[keep_mask] 
            
            unique_positions = sorted(list(set(matched_true_positions)))
            final_knowledge_base[cluster_name] = unique_positions
            
            shrinkage_percent = (1.0 - (len(x) / initial_length)) * 100
            
            if log_callback:
                log_callback(f"🎯 [تصفية {cluster_name}]: تم عزل المواقع الحقيقية.")
                log_callback(f"📉 المصفوفة تنكمش متسارعة إلى: {len(x):,} سامبل (تصفية: {shrinkage_percent:.2f}%).")
                log_callback("-" * 50)
                
            if result_callback:
                result_callback(cluster_name, len(unique_positions))
                
            cluster_counter += 1
        else:
            # صمام أمان التناقص في حال عدم وجود تطابقات في النافذة الحالية
            x = x[1:]
            global_indices = global_indices[1:]
            
    return final_knowledge_base
