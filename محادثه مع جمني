                probabilities_data = json.load(f)
                
            # 3. إعادة بناء خط التوقيع الزمني الموحد (Reverse Timeline Reconstruction)
            master_timeline = []
            for cl_name, timestamps in probabilities_data.items():
                if cl_name in dictionary_data:
                    assigned_char = dictionary_data[cl_name]["assigned_letter"]
                    for t in timestamps:
                        master_timeline.append({'time': t, 'char': assigned_char})
                        
            if not master_timeline:
                self.log("⚠️ تحذير: لم يتم العثور على حروف متطابقة بين قاموس الـ SRT وملف الاحتماليات للتحويل.")
