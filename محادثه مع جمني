# استخراج الثلاثية المبسطة
result = extract_ternary_counts(sample_phoneme_signal)
print(f"📊 الإشارة الصوتية تحولت ببساطة شديدة إلى: {result}")
print(f"-> عدد الـ (+): {result[0]}")
print(f"-> عدد الـ (-): {result[1]}")
print(f"-> عدد الـ (0): {result[2]}")
