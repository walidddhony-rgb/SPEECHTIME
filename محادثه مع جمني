import numpy as np
from scipy.io import wavfile
import json
import os

def run_sliding_precision_elimination(audio_path, segment_ms=150, output_json="precision_clusters.json"):
    """
    تنفيذ خوارزمية التطابق الدقيق خطوة بخطوة (Sliding Precision) المستوحاة من فكرتك:
    التحريك على مستوى السامبل المفرد لاصطياد القمم العليا، ثم الحذف والتصفية التتابعية.
    """
    # 1. تحميل وترتيب ملف الصوت من الصفر
    sr, x = wavfile.read(audio_path)
    x = x.astype(np.float64)
    x += abs(x.min()) # الإزاحة العلوية لحذف المتغيرات الخارجية
    
    total_samples = len(x)
    segment_size = int((segment_ms * sr) // 1000)
    
    print(f"🎬 حجم الملف الصوتي: {total_samples} سامبل.")
    print(f"📐 دقة النافذة المستهدفة: {segment_size} سامبل.")
    
    clusters = {}
    cluster_counter = 0
    
    # مصفوفة قناع لمتابعة العينات النشطة والمحذوفة
    active_mask = np.ones(total_samples, dtype=np.int8)
    
    # استمرار المحرك حتى يتم تصفية الملف بالكامل
    while np.sum(active_mask) > segment_size:
        
        # البحث عن بداية أول مقطع نشط متبقٍ لم يُحذف بعد
        active_indices = np.where(active_mask == 1)[0]
        if len(active_indices) < segment_size:
            break
            
        start_idx = active_indices[0]
        end_idx = start_idx + segment_size
        
        # قص السقمنت الحالية لتكون هي قالب المطابقة الدقيقة
        segment = x[start_idx:end_idx]
        self_similarity = np.sum(segment * segment) # طاقة النمط الذاتية
        
        if self_similarity == 0:
            active_mask[start_idx:end_idx] = 0
            continue
            
        # --- خطوة العبقرية الحركية: التحريك خطوة بخطوة (One Sample Step Convolution) ---
        # تطبيق الضرب الموازي عبر تحريك السقمنت على كامل الملف بضربة معالج واحدة
        # دالة np.correlate بنمط 'same' تحرك العينة خطوة بخطوة (Sample-by-Sample) على كل الإشارة
        x_masked = x * active_mask
        correlation_map = np.correlate(x_masked, segment, mode='same')
        
        # عتبة المطابقة الفائقة (أكبر التطابقات اللحظية في خط الزمن)
        # نحدد القمم التي تتجاوز الـ 85% من التطابق الذاتي المتطابق
        match_threshold = 0.85 * self_similarity
        
        # العثور على مراكز التطابقات الدقيقة في خط سير السامبلز
        exact_match_centers = np.where(correlation_map > match_threshold)[0]
        
        if len(exact_match_centers) == 0:
            active_mask[start_idx:end_idx] = 0
            continue
            
        cluster_name = f"Phoneme_Cluster_{cluster_counter}"
        clusters[cluster_name] = []
        
        # --- خطوة التنزيل والمسح الآلي من الملف الصغير والكبير ---
        for center in exact_match_centers:
            # حساب البداية والنهاية الفعلية للمقطع المتطابق بناءً على مركز الالتفاف (Convolution Center)
            actual_start = max(0, center - (segment_size // 2))
            actual_end = min(total_samples, actual_start + segment_size)
            
            # تسجيل الوقت الفعلي بدقة الساعة الرقمية
            time_sec = actual_start / sr
            if time_sec not in clusters[cluster_name]:
                clusters[cluster_name].append(time_sec)
                
            # حذف المقطع الذي تم قنصه من القناع الأصلي (تصفيره كلياً)
            active_mask[actual_start:actual_end] = 0
            
        print(f"🎯 قنص دقيق [{cluster_name}] -> تم تصفية وحذف {len(exact_match_centers)} مقطعاً متطابقاً على مستوى الـ Sample-Level.")
        cluster_counter += 1
        
    # حفظ القاموس التصفوي النهائي في ملف JSON
    with open(output_json, 'w', encoding='utf-8') as f:
        json.dump(clusters, f, indent=4)
        
    print(f"\n✨ اكتمل المحرك الدقيق كلياً! تم ضغط وتجريد الملف بالكامل إلى {cluster_counter} مخرج فيزيائي نقي.")

# --- تشغيل واختبار محرك المطابقة فائقة الدقة ---
audio_file = "audio.wav"
if os.path.exists(audio_file):
    run_sliding_precision_elimination(audio_file, segment_ms=150)
