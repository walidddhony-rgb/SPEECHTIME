import os
import json
import numpy as np
from scipy.io import wavfile

def run_125ms_probability_engine(audio_path, similarity_threshold=0.85, output_json="arabic_125ms_probabilities.json"):
    """
    محرك الاحتماليات التناقصي السريع لـ SpeechScribe:
    - حجم السامبل مثبت بدقة عند 125 ملي ثانية.
    - حساب مصفوفة الاحتمالات الذاتية اللحظية لكل نقاط خط الزمن الموازي.
    - قنص أعلى القمم وتصفيتها تتابعياً مع انكماش مصفوفة الصوت.
    """
    if not os.path.exists(audio_path):
        print(f"❌ خطأ: لم يتم العثور على الملف الصوتي في: {audio_path}")
        return

    # 1. قراءة الإشارة وتجريد نبرة صوت المتحدث
    sr, x_raw = wavfile.read(audio_path)
    if len(x_raw.shape) > 1:
        x_raw = x_raw[:, 0]
        
    x = x_raw.astype(np.float64)
    x += abs(x.min()) # الإزاحة العلوية لتثبيت طاقة الموجة من الصفر
    
    initial_length = len(x)
    
    # 📏 حساب الطول الدقيق المقابل لـ 125 ملي ثانية
    segment_len = int((125 * sr) // 1000)
    
    print("=" * 70)
    print(f"🚀 محرك الاحتماليات التناقصي الخيالي | حجم السامبل المثبت: 125ms")
    print("=" * 70)
    print(f"🎬 إجمالي عينات الملف البدائية: {initial_length:,} سامبل.")
    print(f"📐 الطول الرقمي لـ 125ms في الذاكرة: {segment_len:,} سامبل.")
    print("-" * 70)

    final_knowledge_base = {}
    cluster_counter = 0
    
    # المحرك يدور طالما أن مصفوفة الصوت المتبقية تكفي لسامبل 125ms واحد على الأقل
    while len(x) >= segment_len:
        
        # اقتطاع سامبل الـ 125ms الحالي من بداية الملف المنكمش
        segment = x[:segment_len]
        segment_energy = np.sum(segment * segment)
        
        if segment_energy == 0:
            x = x[segment_len:] # انكماش فوري عند رصد الصمت المطلق
            continue
            
        cluster_name = f"Phoneme_Group_{cluster_counter}"
        keep_mask = np.ones(len(x), dtype=bool)
        matched_positions = []
        
        # --- التحريك خطوة بخطوة بعدد خانات يساوي طول الـ 125ms فقط لتغطية كل النقاط ---
        for shift in range(segment_len):
            available_len = len(x) - shift
            num_blocks = available_len // segment_len
            truncated_len = num_blocks * segment_len
            
            if num_blocks == 0:
                continue
                
            # بناء القالب المكرر الموازي وتجهيز شريحة الضرب اللحظي
            tiled_pattern = np.tile(segment, num_blocks)
            x_slice = x[shift : shift + truncated_len]
            
            # الضرب المصفوفي النقي وإعادة التشكيل الثنائي لبناء مصفوفة الاحتمالات
            multiplication_result = x_slice * tiled_pattern
            reshaped_matrix = multiplication_result.reshape(num_blocks, segment_len)
            
            # حساب مجاميع الطاقة لكل بلوك توازي
            block_sums = np.sum(reshaped_matrix, axis=1)
            
            # 📊 حساب الاحتمالية لكل بلوك مقارنة بالطاقة الذاتية للسامبل المرجعي
            # نسبة الاحتمالية تتراوح من 0.0 إلى 1.0 (أو أكثر في حال تطابق الارتفاع والشدة)
            block_probabilities = block_sums / segment_energy
            
            # قنص البلوكات التي تتجاوز الاحتمالية المطلوبة (similarity_threshold)
            matched_block_indices = np.where(block_probabilities >= similarity_threshold)
            
            # استخراج المؤشرات الصحيحة وتجهيزها للحذف الفعلي والانكماش
            for b_idx in matched_block_indices:
                actual_start_pos = int(shift + (b_idx * segment_len))
                actual_end_pos = int(actual_start_pos + segment_len)
                
                # طباعة عينة احتمالية للمراقبة في أول مجموعة
                if cluster_counter == 0 and len(matched_positions) < 3:
                    prob_val = float(block_probabilities[b_idx])
                    print(f"   [فحص لحظي] وجدت تشابه في الموقع {actual_start_pos} باحتمالية صريحة: {prob_val:.4f}")
                
                keep_mask[actual_start_pos:actual_end_pos] = False
                matched_positions.append(actual_start_pos / sr)
                
