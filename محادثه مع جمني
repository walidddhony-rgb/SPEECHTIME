        title_frame.pack(pady=15, fill="x", padx=20)
        
        main_title = ctk.CTkLabel(title_frame, text="100ns Analog Optical Core Simulator ⚡💡", font=ctk.CTkFont(size=24, weight="bold"))
        main_title.pack()
        
        ai_credit = ctk.CTkLabel(title_frame, 
                                 text="Multichannel Waveguide Lattice & Real-Time Wave Interference | Co-Engineered via Google AI Frameworks", 
                                 font=ctk.CTkFont(size=11, slant="italic"), text_color="#10B981")
        ai_credit.pack(pady=5)
        
        divider = ctk.CTkFrame(self, height=2, fg_color="#374151")
        divider.pack(fill="x", padx=30, pady=5)
        
        # 2. لوحة التحكم والمدخلات الفيزيائية
        controls_frame = ctk.CTkFrame(self)
        controls_frame.pack(pady=15, padx=30, fill="x")
        
        self.btn_audio = ctk.CTkButton(controls_frame, text="📁 اختيار ملف صوت الفحص (WAV)", command=self.select_audio, width=240, font=ctk.CTkFont(weight="bold"))
        self.btn_audio.grid(row=0, column=0, padx=20, pady=20)
        
        self.lbl_audio_path = ctk.CTkLabel(controls_frame, text="لم يتم اختيار ملف الفحص بعد...", text_color="#9CA3AF")
        self.lbl_audio_path.grid(row=0, column=1, sticky="w", padx=10)
        
        # شريط اختيار عدد قنوات المسارات الضوئية (Waveguides)
        lbl_channels = ctk.CTkLabel(controls_frame, text="عدد المسارات والقنوات (Waveguides):", font=ctk.CTkFont(size=12, weight="bold"))
        lbl_channels.grid(row=1, column=0, padx=20, pady=10, sticky="e")
        
        self.slider_channels = ctk.CTkSlider(controls_frame, from_=2, to=16, number_of_steps=14, command=self.update_channels_label, width=250)
        self.slider_channels.set(4)
        self.slider_channels.grid(row=1, column=1, sticky="w", padx=10, pady=10)
        
        self.lbl_channels_val = ctk.CTkLabel(controls_frame, text="4 قنوات", font=ctk.CTkFont(weight="bold"), text_color="#10B981")
        self.lbl_channels_val.grid(row=1, column=1, padx=270, sticky="w", pady=10)
        
        # 3. زر تشغيل المعالجة الضوئية التناظرية الفورية
        self.btn_run = ctk.CTkButton(self, text="💡 تشغيل الليزر وحساب تداخل الأمواج بدقة 100ns", 
                                      command=self.run_optical_simulation, fg_color="#059669", hover_color="#047857", height=45, font=ctk.CTkFont(size=14, weight="bold"))
        self.btn_run.pack(padx=30, pady=10, fill="x")
        
        # 4. لوحة العرض المزدوجة (الرسم البياني والشاشة اللحظية)
        monitor_frame = ctk.CTkFrame(self, fg_color="transparent")
        monitor_frame.pack(pady=10, padx=30, fill="both", expand=True)
        
        # كونسول التقارير والتحليل الرياضي (الموقع الفيزيائي ومعدل الخطأ)
        log_subframe = ctk.CTkFrame(monitor_frame, fg_color="#0F172A", width=350)
        log_subframe.pack(side="left", fill="both", expand=False, padx=(0, 10))
        log_subframe.pack_propagate(False)
        
        lbl_log = ctk.CTkLabel(log_subframe, text="📊 التقرير الميكرومتري لزوايا ومخارج الصوت:", font=ctk.CTkFont(size=12, weight="bold"), text_color="#94A3B8")
        lbl_log.pack(anchor="w", padx=10, pady=5)
        
        self.txt_log = ctk.CTkTextbox(log_subframe, font=ctk.CTkFont(family="Courier", size=11), text_color="#34D399", fg_color="transparent")
        self.txt_log.pack(fill="both", expand=True, padx=5, pady=5)
        
        # إطار الرسم البياني الضوئي المتزامن (Optical Wave Plotter)
        self.plot_subframe = ctk.CTkFrame(monitor_frame, fg_color="#111827")
        self.plot_subframe.pack(side="right", fill="both", expand=True)
        
        # تجهيز مساحة الرسم عبر Matplotlib داخل الواجهة
        self.fig, self.ax = plt.subplots(figsize=(6, 4), facecolor="#111827")
        self.ax.set_facecolor("#0F172A")
        self.ax.tick_params(colors='white', labelsize=9)
        for spine in self.ax.spines.values():
            spine.set_color('#374151')
            
        self.canvas = FigureCanvasTkAgg(self.fig, master=self.plot_subframe)
        self.canvas.get_tk_widget().pack(fill="both", expand=True, padx=10, pady=10)
        
        self.log("🤖 محاكي المعالج التناظري الضوئي لـ 100ns مستقر ومستعد لضخ أشعة الليزر...")

    def log(self, message):
        self.txt_log.insert("end", message + "\n")
        self.txt_log.see("end")

    def update_channels_label(self, val):
        self.lbl_channels_val.configure(text=f"{int(val)} قنوات")

    def select_audio(self):
        path = filedialog.askopenfilename(filetypes=[("Audio WAV Files", "*.wav")])
        if path:
            self.audio_path = path
            self.lbl_audio_path.configure(text=os.path.basename(path), text_color="#F3F4F6")
            self.log(f"📁 تم ربط ملف إشارة الفحص الأكوستيكي: {path}")

    def run_optical_simulation(self):
        if not self.audio_path:
            messagebox.showwarning("تنبيه", "الرجاء اختيار ملف الصوت WAV التجريبي أولاً!")
            return
            
        self.btn_run.configure(state="disabled", text="⏳ جاري ضخ تيار الضوء وحساب تراكب القمم الضوئية...")
        self.txt_log.delete("1.0", "end")
        
        num_channels = int(self.slider_channels.get())
        
        try:
            from scipy.io import wavfile
            sr, x_raw = wavfile.read(self.audio_path)
            if len(x_raw.shape) > 1:
                x_raw = x_raw[:, 0]
                
            # محاكاة خط التأخير الضوئي التناظري والـ Up-sampling لـ 10MHz
            self.log("💡 خطوة 1: تحويل عينات بايثون الرقمية لخط زمن نانوي (تردد 10 ميجاهرتز)...")
            analog_stream, target_sr, channel_distance = simulate_optical_delay_line(x_raw, sr, delay_ns=100)
            
            # تشغيل محرك التداخل الموجي التناظري بالقنوات متعددة الأطوال
            self.log(f"⚙️ خطوة 2: تمرير تيار الضوء في {num_channels} مسارات ألياف ضوئية بمضاعفات 20 متراً...")
            results = run_multichannel_interference(analog_stream, target_sr, num_channels=num_channels)
            
            # 📊 طباعة تقرير الدقة المجهري والزوايا المضبوطة (TDOA Error Margin)
            self.log("\n📐 📋 --- تقرير الفحص الميكرومتري لـ Google AI ---")
            self.log(f"-> طول ليف القناة الفردية: {results['distance_per_channel_m']} متر (يقابل 100ns).")
            self.log(f"-> أبعاد مصفوفة المسارات متعددة الأطوال: {results['optical_waveguide_shape']}")
            self.log(f"-> حجم عينات التدفق الضوئي التناظري: {results['analog_stream_len']:,} كلوك.")
            
            # حساب وإبراز معدل خطأ الزوايا والموقع الفيزيائي
            error_m = results['micro_error_margin_m']
            self.log(f"-> نسبة الخطأ الميكانيكي للمخرج الصوتي: {error_m * 1000:.3f} ملي متر.")
            self.log(f"-> دقة الحساسية المكانية للزوايا: {error_m * 1000000:.1f} ميكرومتر (خارقة التلسكوبية).")
            self.log(f"-> عدد ومضات الوميض وقمم التطابق المقنوصة: {len(results['flash_timestamps_ns'])} ومضة.")
            self.log("-" * 45)
            
            # 📈 رسم منحنى التداخل الموجي الضوئي وغلاف الطاقة اللحظي
            self.ax.clear()
            env_data = results['interference_envelope']
            
            # لرسم عينة مرئية متناسقة وسريعة، نأخذ نافذة ممثلة من غلاف التداخل
            display_limit = min(len(env_data), 5000)
            time_axis_ns = np.arange(display_limit) * 100 # النطاق بالنانو ثانية
            
            self.ax.plot(time_axis_ns, env_data[:display_limit], color="#10B981", alpha=0.85, label="غلاف تداخل الأمواج التناظري")
            
            # تحديد خط عتبة قنص القمم المكثفة (Optical Interference Threshold)
            threshold_val = 0.85 * np.max(env_data) if np.max(env_data) > 0 else 1.0
            self.ax.axhline(y=threshold_val, color="#EF4444", linestyle="--", alpha=0.7, label="عتبة بؤرة الوميض اللحظي")
            
            self.ax.set_title("Analog Wave Interference Envelope & Optical Peaks", color="white", fontweight="bold", fontsize=11)
            self.ax.set_xlabel("Time (Nanoseconds)", color="white", fontsize=10)
            self.ax.set_ylabel("Light Intensity Amplitude", color="white", fontsize=10)
            self.ax.grid(axis='both', alpha=0.15, linestyle='--')
            self.ax.legend(facecolor="#0F172A", edgecolor="#374151", labelcolor="white")
            
            self.canvas.draw()
            
            self.log("\n✨ اكتملت المحاكاة التناظرية الضوئية بنجاح ساحق!")
            messagebox.showinfo("نجاح المحاكاة", f"اكتملت المحاكاة! تم حساب تداخيل المسارات متعددة الأطوال بدقة مجهرية على مستوى الميكرومتر.")
            
        except Exception as e:
            self.log(f"❌ حدث خطأ في المحاكاة الضوئية: {str(e)}")
            messagebox.showerror("خطأ", f"فشلت المحاكاة الضوئية: {str(e)}")
            
        finally:
            self.btn_run.configure(state="normal", text="💡 تشغيل الليزر وحساب تداخل الأمواج بدقة 100ns")
