# 1. تحويل الفونيمات النصية إلى قيم رقمية فريدة وتجهيز المصفوفة ثنائية الأبعاد (One-Hot Encoding)
unique_phonemes = np.unique(Y)
num_classes = len(unique_phonemes)

# بناء مصفوفة الأهداف العريضة (عدد المقاطع × عدد الفونيمات الفريدة)
Y_onehot = np.zeros((len(Y), num_classes))
for idx, p in enumerate(Y):
    class_idx = np.where(unique_phonemes == p)[0][0]
    Y_onehot[idx, class_idx] = 1

# 2. إضافة عمود الحيز (Bias/Intercept) لمصفوفة الميزات X
# ليصبح لدينا (y = Xw + b)
X_bias = np.hstack([np.ones((X.shape[0], 1)), X])

# 3. حساب الأوزان باستخدام معادلة المربعات الصغرى (Normal Equation)
# ويفضل استخدام pinv (المصفوفة الشبه عكسية) لتفادي مشاكل المصفوفات غير القابلة للعكس
W = np.linalg.pinv(X_bias.T @ X_bias) @ X_bias.T @ Y_onehot

print("تم تدريب النموذج بنجاح وحساب مصفوفة الأوزان W بأبعاد:", W.shape)

# --- طريقة التنبؤ (Prediction) بمقطع صوتي جديد ---
def predict_phoneme(audio_chunk, sr, W, unique_phonemes):
    # 1. استخراج نفس الميزات للمقطع الجديد
    mfcc = librosa.feature.mfcc(y=audio_chunk, sr=sr, n_mfcc=13)
    mfcc_mean = np.mean(mfcc, axis=1).reshape(1, -1)
    
    # 2. إضافة عمود الـ Bias
    feat_with_bias = np.hstack([np.ones((1, 1)), mfcc_mean])
    
    # 3. الضرب في الأوزان المحسوبة بالمربعات الصغرى
    scores = feat_with_bias @ W
    
    # 4. اختيار الفونيم صاحب أعلى قيمة (Score)
    predicted_idx = np.argmax(scores)
    return unique_phonemes[predicted_idx]
