import numpy as np
import json
from sklearn.linear_model import LogisticRegression
import joblib  # لحفظ ثوابت وأوزان المعادلة

def train_predictive_equation(database_file="model_knowledge.json", model_output_file="predictive_weights.pkl"):
    """
    1. قراءة الحروف والأرقام العشرية الناتجة عنها من قاعدة البيانات.
    2. تكوين المصفوفات الرياضية (X: الأرقام العشرية، Y: الحروف).
    3. حساب أوزان وثوابت المعادلة التنبئية.
    4. حفظ الأوزان والتخلص من الحاجة للداتا الأصلية أو الصوت.
    """
    # تحميل قاعدة البيانات التراكمية (الحرف + الأرقام العشرية الناتجة عنه)
    with open(database_file, 'r', encoding='utf-8') as f:
        model_db = json.load(f)
        
    X_data = []
    Y_labels = []
    
    # تحويل البيانات إلى تنسيق مصفوفات رياضية
    for phoneme, decimal_keys in model_db.items():
        for key in decimal_keys:
            # نضع الرقم العشري كميزة مدخلة (Feature)
            X_data.append([float(key)])
            Y_labels.append(phoneme)
            
    X = np.array(X_data)
    Y = np.array(Y_labels)
    
    if len(X) == 0:
        print("❌ قاعدة البيانات فارغة! يرجى تغذية النموذج بالبيانات أولاً.")
        return
        
    print(f"📊 تم تحميل {len(X)} عينة حرفية. جاري حساب ثوابت المعادلة التنبئية...")
    
    # تكوين المعادلة التنبئية اللوجستية (التي تحسب أوزان الفصل بين الأرقام العشرية للحروف)
    # y_pred = Softmax(W * X + B)
    predictive_model = LogisticRegression(multi_class='multinomial', solver='lbfgs', max_iter=1000)
    predictive_model.fit(X, Y)
    
    # استخراج الثوابت الرياضية الناتجة
    W = predictive_model.coef_       # مصفوفة الأوزان (المعاملات الخطية) لكل حرف
    B = predictive_model.intercept_  # مصفوفة الثوابت (الانحياز/Intercept) لكل حرف
    classes = predictive_model.classes_ # ترتيب الحروف في المعادلة
    
    print("\n🔮 تم إيجاد ثوابت المعادلة بنجاح!")
    print(f"-> عدد الحروف المعرّفة في المعادلة: {len(classes)}")
    print(f"-> أبعاد مصفوفة الأوزان W: {W.shape}")
    print(f"-> أبعاد مصفوفة الثوابت B: {B.shape}")
    
    # حفظ الثوابت والأوزان فقط في ملف صغير جداً (كيلوبايتات)
    model_data = {
        'weights': W,
        'biases': B,
        'classes': classes
    }
    joblib.dump(model_data, model_output_file)
    print(f"💾 تم حفظ أوزان المعادلة في الملف: {model_output_file}")
    print("🗑️ الآن يمكنك حذف الملفات الصوتية وقاعدة البيانات الضخمة بأمان؛ المعادلة أصبحت مستقلة!")

# --- تشغيل عملية إيجاد الثوابت وحفظ الأوزان ---
train_predictive_equation()
