    النواة التناقصية المطلقة والآمنة للذاكرة العشوائية بنسبة 100% (نسخة معالجة الـ Tuple):
    - تم حل مشكلة الأبعاد والصدمة الإندكسية بتحويل مصفوفة np.where إلى أرقام مفردة مسطحة.
    - الحفاظ على الحساب الرياضي اللحظي فائق الخفة والتثبيت الصارم عند 200ms الشاملة.
    """
    if not os.path.exists(audio_path):
        if log_callback: log_callback("❌ خطأ: لم يتم العثور على ملف الصوت!")
        return {}

    ternary_signal, sr = extract_pure_200ms_envelope_safe(audio_path)
    initial_length = len(ternary_signal)
    segment_len = int((200 * sr) // 1000) # 200ms الشاملة
    
    if log_callback:
        log_callback(f"🎬 إجمالي عينات الملف البدائية: {initial_length:,} سامبل.")
        log_callback(f"📐 طول نافذة الـ 200ms الثابتة: {segment_len:,} سامبل.")
        log_callback("🛡️ وضع الحماية المطلقة نشط: تم التحول للحساب الرياضي اللحظي وسحق مشاكل الـ RAM.")
        log_callback("-" * 50)

    final_knowledge_base = {}
    cluster_counter = 0
    
    # عداد العينات المقتطعة التراكمي
    accumulated_deleted_samples = 0
    
    x = np.copy(ternary_signal)
    chunk_buffer_limit = segment_len * 20 # نطاق موازي مؤقت محمي ومحجوز للذاكرة العشوائية
    
    while len(x) >= segment_len:
        segment = x[:segment_len]
        segment_energy = np.sum(segment * segment)
        
        if segment_energy == 0:
            x = x[segment_len:]
            accumulated_deleted_samples += segment_len
            continue
            
        cluster_name = f"Phoneme_Cluster_{cluster_counter}"
        keep_mask = np.ones(len(x), dtype=bool)
        matched_true_positions = []
        
        current_processing_limit = min(len(x), chunk_buffer_limit)
        
        for shift in range(segment_len):
            available_len = current_processing_limit - shift
            num_blocks = available_len // segment_len
            truncated_len = num_blocks * segment_len
            
            if num_blocks == 0:
                continue
                
            tiled_pattern = np.tile(segment, num_blocks)
            x_slice = x[shift : shift + truncated_len]
            
            multiplication_result = x_slice * tiled_pattern
            reshaped_matrix = multiplication_result.reshape(num_blocks, segment_len)
            
            block_sums = np.sum(reshaped_matrix, axis=1)
            block_probabilities = block_sums / segment_energy
            
            matched_block_indices = np.where(block_probabilities >= similarity_threshold)
            
            # 🌟 خطوة التصحيح الجوهرية: استخراج العناصر كمصفوفة مسطحة وصافية صالحة للأرقام الصحيحة
            # matched_block_indices[0] تسحب الإندكسات المباشرة بداخل الـ Tuple وتحميها من التداخل البنيوي
            for b_idx in matched_block_indices[0].flatten():
                actual_start_pos = int(shift + (int(b_idx) * segment_len))
                actual_end_pos = int(actual_start_pos + segment_len)
                
                keep_mask[actual_start_pos:actual_end_pos] = False
                
                # المعادلة الرياضية البديلة للمصفوفة المفقودة (مستقلة الذاكرة)
                true_sample_index = actual_start_pos + accumulated_deleted_samples
                matched_true_positions.append(true_sample_index / sr)
                
        # --- خطوة الحذف الفعلي والانكماش الديناميكي المتسارع الخفيف ---
        if len(matched_true_positions) > 0:
            samples_before_shrink = len(x)
            
            x = x[keep_mask] # الانكماش الفعلي للإشارة
            
            samples_after_shrink = len(x)
            # تحديث العداد التراكمي بالفارق الفعلي الممسوح بلمح البصر
            accumulated_deleted_samples += (samples_before_shrink - samples_after_shrink)
            
            unique_positions = sorted(list(set(matched_true_positions)))
            final_knowledge_base[cluster_name] = unique_positions
            
            shrinkage_percent = (1.0 - (len(x) / initial_length)) * 100
            
            if log_callback:
                log_callback(f"🎯 [تصفية {cluster_name}]: تم عزل المواقع الحقيقية رياضياً.")
                log_callback(f"📉 Matrix تنكمش متسارعة إلى: {len(x):,} سامبل (تصفية: {shrinkage_percent:.2f}%).")
                log_callback("-" * 50)
                
            if result_callback:
                result_callback(cluster_name, len(unique_positions))
                
            cluster_counter += 1
        else:
            x = x[1:]
            accumulated_deleted_samples += 1
            
    return final_knowledge_base
