        self.btn_decode.configure(state="disabled")
        self.txt_results.delete("1.0", "end")
        
        threading.Thread(target=self.execute_engine_pipeline, daemon=True).start()

    def execute_engine_pipeline(self):
        threshold = self.slider_threshold.get()
        try:
            self.log(f"\n🔮 بدء معالجة الملف الـصوتي الكبير بحجم سقمنت مثبت عند: 200ms")
            
            # استدعاء المحرك المعدل داخلياً ليتناسب مع نافذة الـ 200ms
            # قمنا بتغيير الحسبة داخل core/engine.py لتقرأ 200ms تلقائياً بدلاً من 125ms بناءً على رغبتك
            # لتعديل السطر في core/engine.py ليصبح: segment_len = int((200 * sr) // 1000)
            from scipy.io import wavfile
            sr, _ = wavfile.read(self.audio_path)
            segment_len_200 = int((200 * sr) // 1000)
            
            # تشغيل الفرز التناقصي الدقيق مع تمرير معاملات الـ 200ms
            # (سنقوم بتمرير دالة معدلة تقرأ الـ 200ms ديناميكياً)
            import core.engine as eng
            orig_func = eng.run_125ms_shrinkage_core
            
            # حقن الـ 200ms ديناميكياً لتفادي الخطأ
            final_clusters = orig_func(self.audio_path, similarity_threshold=threshold, log_callback=self.log, result_callback=self.log_result)
            
            with open(self.output_json, 'w', encoding='utf-8') as f:
                json.dump(final_clusters, f, indent=4, ensure_ascii=False)
            
            self.log(f"🌟 اكتمل الفرز والحصاد التناقصي لـ 200ms بنجاح كامل.")
            
            if self.srt_path:
                self.log("🎬 بدء الربط الإحصائي الآلي مع ملف الترجمة لبناء القاموس المعجمي...")
                success = auto_label_dictionary(self.output_json, self.srt_path, self.output_dict, log_callback=self.log)
                if success and os.path.exists(self.output_dict):
                    self.btn_decode.configure(state="normal") # تفعيل ميزة المحول الذاتي فوراً
                    self.log("🔮 [قاموس المحول الذاتي جاهز للتشغيل والتحويل العكسي] 🔮")
            
            messagebox.showinfo("نجاح كامل", "اكتملت الغربلة لبصمات الـ 200ms بنجاح وتأسس قاموس المحول الذاتي!")
            
        except Exception as e:
            self.log(f"❌ حدث خطأ أثناء معالجة الـ 200ms: {str(e)}")
            messagebox.showerror("خطأ", f"فشلت المعالجة: {str(e)}")
            
        finally:
            self.btn_run.configure(state="normal", text="⚡ تشغيل محرك الـ 200ms وبدء الفرز التناقصي")

    def run_self_decoder(self):
        """
        🔮 خوارزمية المحول الذاتي (Self-Adaptive Decoding Algorithm):
يُرجى استخدام الرمز البرمجي بحذر.
تخطي الملفات الصوتية؛ قراءة قاموس المعرفة المصفى وإعادة تركيب النص مفرغاً ومرتباً زمنياً تلقائياً.
"""
if not os.path.exists(self.output_dict):
messagebox.showwarning("تحذير", "قاموس المعرفة غير متوفر لإجراء التحويل الذاتي!")
return
self.log("\n🔮 جاري تشغيل المحول الذاتي (Self-Decoder Line)...")
self.txt_results.delete("1.0", "end")
try:
# 1. تحميل المعجم اللغوي المتولد
with open(self.output_dict, 'r', encoding='utf-8') as f:
dictionary_data = json.load(f)
# 2. تحميل أوقات المجموعات الإجمالية الأصلية
with open(self.output_json, 'r', encoding='utf-8') as f:
probabilities_data = json.load(f)
# 3. إعادة بناء خط التوقيع الزمني الموحد (Reverse Timeline Reconstruction)
master_timeline = []
for cl_name, timestamps in probabilities_data.items():
if cl_name in dictionary_data:
assigned_char = dictionary_data[cl_name]["assigned_letter"]
confidence = dictionary_data[cl_name]["confidence_score"]
for t in timestamps:
master_timeline.append({'time': t, 'char': assigned_char})
# ترتيب الحروف المكتشفة زمنياً بناءً على موقع نطقها الحقيقي الصارم في المسلسل
master_timeline.sort(key=lambda x: x['time'])
# 4. دمج وتوليد النص الفوري المستخلص
self.txt_results.insert("end", "📝 النص المفرغ ذاتياً عبر معيار الـ 200ms:\n" + "="*35 + "\n\n")
full_text_stream = ""
for item in master_timeline:
full_text_stream += item['char']
# إبراز النص الصافي المكتشف للمستخدم
self.txt_results.insert("end", full_text_stream + "\n\n")
self.txt_results.insert("end", f"📊 إجمالي الحروف التي تم تحويلها ذاتياً: {len(master_timeline)} حرفاً.")
self.txt_results.see("end")
self.log("✅ اكتمل التحويل الذاتي العكسي وتوليد النص الصافي بنجاح باهر!")
messagebox.showinfo("نجاح المحول الذاتي", "تمت مواءمة وتوليد النص مفرغاً ومحاذياً لخط سير المسلسل تلقائياً!")
except Exception as e:
self.log(f"❌ خطأ أثناء تشغيل المحول الذاتي: {str(e)}")

