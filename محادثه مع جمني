import numpy as np
import librosa
import re

def load_timestamps(txt_path):
    """قراءة ملف الأوقات واستخراج الوقت والفونيم المقابل له"""
    phonemes_data = []
    # التعبير النمطي لقراءة الوقت والفونيم
    pattern = r"\[(\d+):(\d+):(\d+),(\d+)\]\s+time\s+(.+)"
    
    with open(txt_path, 'r', encoding='utf-8') as f:
        for line in f:
            match = re.match(pattern, line.strip())
            if match:
                hrs, mins, secs, ms, phoneme = match.groups()
                # تحويل الوقت بالكامل إلى ثواني
                total_seconds = int(hrs)*3600 + int(mins)*60 + int(secs) + int(ms)/1000.0
                phonemes_data.append((total_seconds, phoneme.strip()))
    return phonemes_data

def build_dataset(audio_path, txt_path):
    phonemes_data = load_timestamps(txt_path)
    y, sr = librosa.load(audio_path, sr=None)
    
    X_features = []
    Y_labels = []
    
    for i in range(len(phonemes_data) - 1):
        start_time, phoneme = phonemes_data[i]
        end_time, _ = phonemes_data[i+1] # نهاية الفونيم هي بداية الفونيم التالي
        
        # تجاهل الفراغات والسكتات في التدريب
        if phoneme in ['_', '-']:
            continue
            
        # تحويل الوقت إلى عينات (Samples)
        start_sample = int(start_time * sr)
        end_sample = int(end_time * sr)
        
        # قص المقطع الصوتي للفونيم
        audio_chunk = y[start_sample:end_sample]
        
        if len(audio_chunk) < 512: # تخطي المقاطع القصيرة جداً التي لا يمكن تحليلها
            continue
            
        # استخراج ميزات MFCC (بصمة التردد) وتثبيتها كـ 13 ميزة متوسطة
        mfcc = librosa.feature.mfcc(y=audio_chunk, sr=sr, n_mfcc=13)
        mfcc_mean = np.mean(mfcc, axis=1) # أبعاد ثابتة (13,) لكل فونيم
        
        X_features.append(mfcc_mean)
        Y_labels.append(phoneme)
        
    return np.array(X_features), np.array(Y_labels)

# تشغيل تجهيز البيانات
# X: مصفوفة الميزات (عدد المقاطع × 13)
# Y: مصفوفة أنواع الفونيمات (مثل: ['ب', 'س', 'م', ...])
X, Y = build_dataset("audio.wav", "times.txt")
print(f"تم تجهيز {len(X)} مقطع صادر للتدريب بأبعاد {X.shape}")
