import os
import numpy as np
from scipy.io import wavfile
from scipy.signal import hilbert, butter, filtfilt

def butter_lowpass_filter(data, cutoff, fs, order=4):
    """مرشح لتنعيم غلاف الطاقة وعزل ترددات الحبال الصوتية المرتفعة"""
    nyq = 0.5 * fs
    normal_cutoff = cutoff / nyq
    b, a = butter(order, normal_cutoff, btype='low', analog=False)
    return filtfilt(b, a, data)

def extract_pure_200ms_envelope_safe(audio_path):
    """نسخة حماية الذاكرة: تقسيم الإشارة لمنع انفجار complex128 في الذاكرة"""
    sr, x_all = wavfile.read(audio_path)
    if len(x_all.shape) > 1:
        x_all = x_all[:, 0]
    x_all = x_all.astype(np.float64)
    x_all += abs(x_all.min())
    
    total_samples = len(x_all)
    chunk_samples = int(30 * sr) # كتل آمنة بطول 30 ثانية
    
    ternary_signal_list = []
    
    for start_pos in range(0, total_samples, chunk_samples):
        end_pos = min(total_samples, start_pos + chunk_samples)
        x_chunk = x_all[start_pos:end_pos]
        
        if len(x_chunk) < 512:
            continue
            
        analytic_signal = hilbert(x_chunk)
        amplitude_envelope = np.abs(analytic_signal)
        
        word_structure_signal = butter_lowpass_filter(amplitude_envelope, cutoff=25, fs=sr, order=4)
        word_structure_signal += abs(word_structure_signal.min())
        
        diff_signal = np.sign(np.roll(word_structure_signal, -1) - word_structure_signal)
        ternary_chunk = (diff_signal + 1).astype(np.int8)
        
        ternary_signal_list.append(ternary_chunk)
        
    final_ternary_signal = np.concatenate(ternary_signal_list)
    return final_ternary_signal, sr

