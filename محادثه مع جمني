import numpy as np
from scipy.io import wavfile
import json

def run_parallel_elimination(audio_path, segment_ms=150, output_json="elimination_clusters.json"):
    """
    تنفيذ خوارزمية التصفية المتوازية الذكية المستوحاة من فلسفتك:
    تكرار الـ Segment عبر np.tile والضرب المصفوفي وحذف المتطابقات تتابعياً.
    """
    # 1. تحميل ملف الصوت الأصلي
    sr, x = wavfile.read(audio_path)
    # تحويل البيانات إلى float64 وتثبيتها من الصفر (بناءً على معادلاتك السابقة لحذف نبرة الصوت)
    x = x.astype(np.float64)
    x += abs(x.min()) 
    
    total_samples = len(x)
    
    # 2. حساب طول السقمنت بالسامبلز بناءً على الملي سكند المطلوب
    # (150 * sr) // 1000
    segment_size = int((segment_ms * sr) // 1000)
    
    print(f"🎬 إجمالي عينات الملف الصوتي: {total_samples} سامبل.")
    print(f"📐 طول السقمنت المستهدف ({segment_ms} ملي ثانية): {segment_size} سامبل.")
    
    clusters = {}
    cluster_counter = 0
    
    # مصفوفة قناع (Mask) لتتبع العينات التي تم حذفها وتصفيرها
    # 1 تعني عينة نشطة، 0 تعني عينة تم حذفها وتجميعها سابقاً
    active_mask = np.ones(total_samples, dtype=np.int8)
    
    # استمرار الحلقة حتى يفرغ الملف الصوتي من العينات النشطة
    while np.sum(active_mask) > segment_size:
        
        # البحث عن أول 1000 عينة نشطة (لم تحذف بعد) من بداية الملف
        active_indices = np.where(active_mask == 1)[0]
        if len(active_indices) < segment_size:
            break
            
        start_idx = active_indices[0]
        end_idx = start_idx + segment_size
        
        # أخذ السقمنت الحالية (القالب المستهدف للبحث)
        segment = x[start_idx:end_idx]
        
        # حساب عدد التكرارات الكاملة الممكنة في المساحة المتبقية من الملف
        num_repeats = total_samples // segment_size
        truncated_length = num_repeats * segment_size
        
        # --- خطوة العبقرية البرمجية: np.tile ---
        # تكرار السقمنت على كامل طول المصفوفة المتوازية بلمح البصر
        tiled_segments = np.tile(segment, num_repeats)
        
        # مواءمة طول الإشارة الأصلية مع طول المصفوفة المكررة
        x_truncated = x[:truncated_length]
        mask_truncated = active_mask[:truncated_length]
        
        # الضرب المصفوفي الموازي (الإشارة الأصلية * القالب المكرر)
        # نضرب في الـ mask أيضاً لضمان عدم مطابقة الأماكن المحذوفة سابقاً
        multiplication_result = x_truncated * tiled_segments * mask_truncated
        
        # إعادة التشكيل (Reshape) لتصبح الأبعاد: (عدد التكرارات × 1000)
        reshaped_matrix = multiplication_result.reshape(num_repeats, segment_size)
        
        # حساب طاقة التشابه التجميعية لكل سقمنت في الملف (Summation across rows)
        similarity_scores = np.sum(reshaped_matrix, axis=1)
        
        # تحديد "عتبة الاحتمال الأكبر" (Similarity Threshold) لتعريف المقاطع المتشابهة
        # نعتبر أي مقطع تزيد نسبة تشابهه عن 85% من التشابه الذاتي الكلي هو مقطع مطابق ويجب حذفه
        self_similarity = np.sum(segment * segment)
        matching_indices = np.where(similarity_scores > (0.85 * self_similarity))[0]
        
        if len(matching_indices) == 0:
            # حماية لمنع الحلقات اللانهائية في حال عدم وجود تشابه
            active_mask[start_idx:end_idx] = 0
            continue
            
        # تسجيل هذه المجموعة (Cluster) في قاعدة البيانات
        cluster_name = f"Cluster_{cluster_counter}"
        clusters[cluster_name] = []
        
        # --- خطوة النزول والحذف من المتغير الأصلي ---
        for match_idx in matching_indices:
            actual_start = match_idx * segment_size
            actual_end = actual_start + segment_size
            
            # حساب الوقت بالثواني لتسجيله
            time_sec = actual_start / sr
            clusters[cluster_name].append(time_sec)
            
            # الحذف من المصفوفة الأصلية (عبر تصفير القناع النشط)
            active_mask[actual_start:actual_end] = 0
            
        print(f"🎯 المجموعات المسجلة [{cluster_name}] -> عثرت على {len(matching_indices)} مقطعاً متشابهاً وتم حذفهم آلياً.")
        cluster_counter += 1
        
    # حفظ نتائج التجميع السريع في ملف JSON
    with open(output_json, 'w', encoding='utf-8') as f:
        json.dump(clusters, f, indent=4)
        
    print(f"\n✨ اكتملت خوارزمية التصفية بنجاح! تم اختزال الملف الصوتي كاملاً إلى {cluster_counter} مجموعة فريدة.")
    print(f"💾 تم حفظ مخرجات المجموعات في ملف: '{output_json}'")

# --- تشغيل وتجربة خوارزميتك المبتكرة ---
# تأكد من وضع ملف صوتي متاح لديك لبدء التصفية المتوازية الخارقة
