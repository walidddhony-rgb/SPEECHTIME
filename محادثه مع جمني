import os
import re
import json

def parse_srt_to_timeline(srt_path):
    """
    محلل ملف الأوقات اللحظية المبتكر:
    يقوم بقراءة وقت الحرف المفرد، ويصنع له نافذة افتراضية مقدارها 200 ملي ثانية (0.200 ثانية).
    """
    if not os.path.exists(srt_path):
        return []
        
    subtitles = []
    # التعبير النمطي لقراءة الوقت المفرد سواء احتوى على نقطة أو فاصلة: [00:00:00.000] أو [00:00:00,000]
    time_pattern = r"\[(\d{2}):(\d{2}):(\d{2})[\.,](\d{3})\]\s+(.+)"
    
    with open(srt_path, 'r', encoding='utf-8') as f:
        for line in f:
            match = re.search(time_pattern, line.strip())
            if match:
                hrs, mins, secs, ms, text = match.groups()
                
                # حساب وقت البداية بدقة بالثواني
                start_sec = int(hrs)*3600 + int(mins)*60 + int(secs) + int(ms)/1000.0
                
                # 🌟 خطوة العبقرية النسبية الخاصة بك: وقت النهاية = وقت البداية + حجم السقمنت الحالي (200ms)
                end_sec = start_sec + 0.200
                
                # تنظيف النص والاحتفاظ بالحروف العربية فقط (حذف الشحطات والرموز مثل -ا)
                clean_text = re.sub(r'[^\u0600-\u06FF]', '', text)
                
                if clean_text:
                    subtitles.append({'start': start_sec, 'end': end_sec, 'text': clean_text})
                    
    return subtitles

def auto_label_dictionary(probabilities_json_path, srt_path, output_dictionary_path="final_speech_dictionary.json", log_callback=None):
    """
    ربط ملف الاحتماليات التناقصی مع ملف الأوقات اللحظية المصحح لمنع تداخل النسب كلياً.
    """
    if not os.path.exists(probabilities_json_path) or not os.path.exists(srt_path):
        if log_callback: log_callback("❌ خطأ: ملف الاحتماليات أو ملف الأوقات غير موجود!")
        return False

    with open(probabilities_json_path, 'r', encoding='utf-8') as f:
        clusters_data = json.load(f)
        
    srt_timeline = parse_srt_to_timeline(srt_path)
    if not srt_timeline:
        if log_callback: log_callback("❌ خطأ: لم يتم العثور على أوقات حروف صالحة في الملف!")
        return False
        
    final_dictionary = {}
    if log_callback: log_callback("\n⏳ جاري بدء المطابقة الإحصائية الدقيقة بناءً على النوافذ اللحظية المبتكرة...")

    # عتبة سماحية مرنة جداً تتوافق مع الـ 200ms
    tolerance_seconds = 0.1

    for cluster_name, timestamps in clusters_data.items():
        letter_votes = {}
        
        for t_stamp in timestamps:
            for sub in srt_timeline:
                # التحقق مما إذا كان توقيت الفونيم يقع في نافذة الـ 200ms الخاصة بالحرف
                if (sub['start'] - tolerance_seconds) <= t_stamp <= (sub['end'] + tolerance_seconds):
                    for char in sub['text']:
                        letter_votes[char] = letter_votes.get(char, 0) + 1
                        
        if letter_votes:
            # اقتناص الحرف الفعلي الذي يهيمن على هذا التوقيت
            true_letter = max(letter_votes, key=letter_votes.get)
            total_votes = sum(letter_votes.values())
            confidence = (letter_votes[true_letter] / total_votes) * 100
            
            final_dictionary[cluster_name] = {
                "assigned_letter": true_letter,
                "confidence_score": f"{confidence:.2f}%",
                "instances_found": len(timestamps)
            }
            if log_callback:
                log_callback(f"✔️ [{cluster_name}] -> تم الربط اللحظي: الحرف ({true_letter}) بثقة: {confidence:.2f}%")

    with open(output_dictionary_path, 'w', encoding='utf-8') as f:
        json.dump(final_dictionary, f, indent=4, ensure_ascii=False)
        
    if log_callback:
        log_callback(f"💾 تم حفظ معجم المعرفة اللغوية اللحظي في: '{output_dictionary_path}'")
    return True
