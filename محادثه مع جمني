import os
import json
import numpy as np
from scipy.io import wavfile

def run_academic_shrinkage_engine(audio_path, segment_ms=150, similarity_threshold=0.85, output_json="final_arabic_clusters.json"):
    """
    المحرك التناقصي الفائق (Super-Fast Shrinkage Engine):
    - معالجة مصفوفية صرفة (بايثون/نمباي) مستقلة عن الذكاء الاصطناعي التقليدي والـ FFT.
    - تنفيذ دقيق لمنطق (عدد الحروف 28 × طول السقمنت) مع انكماش ديناميكي متسارع لحجم الملف.
    """
    if not os.path.exists(audio_path):
        print(f"❌ خطأ: ملف الصوت غير موجود في المسار المحدد: {audio_path}")
        return

    # 1. تحميل وترتيب الإشارة الرقمية للصوت من الصفر
    sr, x_raw = wavfile.read(audio_path)
    
    # إذا كان الصوت ستيريو (قناتين)، نأخذ قناة واحدة فقط لتسريع المعالجة
    if len(x_raw.shape) > 1:
        x_raw = x_raw[:, 0]
        
    x = x_raw.astype(np.float64)
    # إزاحة علوية تامة لتوحيد الطاقة وعزل البصمة الترددية للمتحدث (نظريتك النسبية)
    x += abs(x.min())
    
    initial_length = len(x)
    segment_len = int((segment_ms * sr) // 1000)
    
    print("=" * 60)
    print("🎙️  محرك SPEECHSCRIBE التناقصي الفائق - تم التشغيل بنجاح")
    print("=" * 60)
    print(f"🎬 حجم الملف الصوتي البدائي: {initial_length:,} عينة (سامبل).")
    print(f"📐 طول السقمنت الحرفي المستهدف: {segment_len:,} عينة.")
    print("-" * 60)

    final_knowledge_base = {}
    cluster_counter = 0
    
    # الدوران مستمر طالما أن مصفوفة الصوت المتبقية تحتوي على مساحة تكفي لسقمنت واحدة على الأقل
    while len(x) >= segment_len:
        
        # اقتطاع السقمنت الحالية من بداية الملف المنكمش دائماً
        segment = x[:segment_len]
        segment_energy = np.sum(segment * segment) # طاقة النمط المرجعية
        
        # حماية من المقاطع الصامتة تماماً
        if segment_energy == 0:
            x = x[segment_len:] # انكماش فوري عبر تجاوز الصمت
            continue
            
        cluster_name = f"Letter_Cluster_{cluster_counter}"
        
        # مصفوفة منطقية (Boolean Mask) لتتبع الأماكن التي سيتم قنصها وحذفها من الملف بأكمله
        # True تعني عينة مستقرة ونظيفة، False تعني عينة متطابقة وسيتم تصفيتها وانكماشها
        keep_mask = np.ones(len(x), dtype=bool)
        matched_positions = []
        
        # --- خطوة العبقرية النسبية: التحريك بخطوات تساوي طول السقمنت فقط ---
        for shift in range(segment_len):
            
            available_len = len(x) - shift
            num_blocks = available_len // segment_len
            truncated_len = num_blocks * segment_len
            
            if num_blocks == 0:
                continue
                
            # صناعة القالب المكرر الموازي على طول المصفوفة الحالية بلمح البصر
            tiled_pattern = np.tile(segment, num_blocks)
            
            # اقتطاع الشريحة الحالية المتوافقة مع الإزاحة من ملف الصوت المنكمش
            x_slice = x[shift : shift + truncated_len]
            
            # الضرب المصفوفي النقطي الفوري الموازي في الذاكرة
            multiplication_result = x_slice * tiled_pattern
            
            # إعادة التشكيل السريع (Reshape): مصفوفة ثنائية الأبعاد (عدد الكتل × طول السقمنت)
            reshaped_matrix = multiplication_result.reshape(num_blocks, segment_len)
            
            # جمع طاقة كل كتلة بشكل متوازٍ وسريع جداً
            block_sums = np.sum(reshaped_matrix, axis=1)
            
            # صيد الكتل التي يتجاوز تشابهها نسبة السماحية المطلوبة
            matched_block_indices = np.where(block_sums >= (similarity_threshold * segment_energy))[0]
            
            # تسجيل مؤشرات الحذف الفعلي وتحديد أوقاتها بالثواني
            for b_idx in matched_block_indices:
                actual_start_pos = shift + (b_idx * segment_len)
                actual_end_pos = actual_start_pos + segment_len
                
                # وسم هذه المنطقة للحذف والانكماش الكلي
                keep_mask[actual_start_pos:actual_end_pos] = False
                matched_positions.append(actual_start_pos / sr)
                
        # --- خطوة الانكماش الديناميكي المتسارع لملف الصوت (Dynamic Compacting) ---
        if len(matched_positions) > 0:
            # تحديث مصفوفة x بقص وحذف كافة الحروف المتطابقة التي تم اصطيادها وتصفيتها
            x = x[keep_mask]
            
            # تسجيل المجموعة ونقاط تواجدها الزمني في القاموس
            final_knowledge_base[cluster_name] = sorted(list(set(matched_positions)))
            
            # حساب نسبة الانكماش الحالية وإبراز السرعة الخيالية
            shrinkage_percent = (1.0 - (len(x) / initial_length)) * 100
            print(f"🎯 [تصفية {cluster_name}]: قنص وحذف {len(matched_positions)} موقعاً متطابقاً بكفاءة.")
            print(f"📉 انكماش الملف الصوتي الإجمالي الآن بنسبة: {shrinkage_percent:.2f}% (المتبقي: {len(x):,} عينة).")
            print("-" * 60)
            
            cluster_counter += 1
        else:
            # حماية متطورة لمنع الحلقات اللانهائية في حال عدم وجود أي تشابه
            x = x[1:]
            
    # 2. حفظ قاعدة المعرفة المصفاة والمضغوطة في ملف JSON نقي
    with open(output_json, 'w', encoding='utf-8') as f:
        json.dump(final_knowledge_base, f, indent=4, ensure_ascii=False)
        
    print("🌟 [تم اكتمال المعالجة الخيالية بنجاح] 🌟")
    print(f"-> تم اختزال الساعات الصوتية بالكامل إلى {cluster_counter} فئة حرفية مجردة.")
    print(f"💾 تم حفظ مخرجات المجموعات النظيفة في ملف الذاكرة: '{output_json}'")
    print("=" * 60)

# --- 🚀 تشغيل وتجربة الكود الأكاديمي المطور ---
