import numpy as np
from scipy.io import wavfile
from scipy.signal import hilbert, butter, filtfilt
import re
import json

def butter_lowpass_filter(data, cutoff, fs, order=4):
    """مرشح رقمي لحذف ترددات الحبال الصوتية المرتفعة والاحتفاظ بهيكل الطاقة اللحظي"""
    nyq = 0.5 * fs
    normal_cutoff = cutoff / nyq
    b, a = butter(order, normal_cutoff, btype='low', analog=False)
    return filtfilt(b, a, data)

def process_pure_word_signal(audio_path):
    """
    معالجة الصوت ليعتمد على طاقة الكلمة والحرف فقط:
    إلغاء بصمة المتحدث + تحويل النظام الثلاثي (0, 1, 2)
    """
    sr, x = wavfile.read(audio_path)
    x = x.astype(np.float64)
    
    # 1. استخراج غلاف الطاقة اللحظي (عزل نبرة المتحدث والـ Pitch)
    analytic_signal = hilbert(x)
    amplitude_envelope = np.abs(analytic_signal)
    
    # فلتر تمرير منخفض بتردد قطع 25 هرتز (يمثل حركة أعضاء النطق البشري الفم واللسان فقط)
    word_structure_signal = butter_lowpass_filter(amplitude_envelope, cutoff=25, fs=sr, order=4)
    
    # 2. تطبيق معادلاتك الرياضية الثلاثية
    # الإزاحة العلوية لمنع القيم السالبة
    word_structure_signal += abs(word_structure_signal.min())
    
    # حساب إشاريّة اتجاه حركة الطاقة (صعود، ثبات، هبوط)
    x1 = np.sign(np.roll(word_structure_signal, -1) - word_structure_signal)
    
    # تحويل الإشارة إلى نظام ثلاثي نقي (0, 1, 2)
    ternary_signal = (x1 + 1).astype(np.int8)
    
    return ternary_signal, sr

def ternary_to_fixed_decimal(ternary_slice, fixed_length=24):
    """
    تحويل نسيج الفونيم أو الكلمة الثلاثي إلى رقم عشري ثابت الطول (Decimal Hash).
    يتم توحيد طول المصفوفة لضمان ألا يعتمد المعرّف على سرعة نطق المتحدث (Time Normalization).
    """
    if len(ternary_slice) == 0:
        return 0
        
    # إعادة تشكيل الطول بأبعاد ثابتة (مثلاً 24 نقطة متميزة تمثل هيكل نطق الحرف)
    indices = np.linspace(0, len(ternary_slice) - 1, fixed_length, dtype=int)
    normalized_ternary = ternary_slice[indices]
    
    # التحويل الرياضي للنظام العشري (الأساس 3)
    decimal_value = 0
    for power, digit in enumerate(reversed(normalized_ternary)):
        decimal_value += int(digit) * (3 ** power)
        
    return decimal_value

def parse_speechscribe_times(txt_path):
    """قراءة وحصر الحروف المتولدة من ملف مشروعك الأول"""
    phonemes_data = []
    pattern = r"\[(\d+):(\d+):(\d+),(\d+)\]\s+time\s+(.+)"
    
    with open(txt_path, 'r', encoding='utf-8') as f:
        for line in f:
            match = re.match(pattern, line.strip())
            if match:
                hrs, mins, secs, ms, phoneme = match.groups()
                total_seconds = int(hrs)*3600 + int(mins)*60 + int(secs) + int(ms)/1000.0
                phonemes_data.append((total_seconds, phoneme.strip()))
    return phonemes_data

def update_model_database(audio_path, txt_path, database_file="model_knowledge.json"):
    """
    تغذية النموذج بآلاف المقاطع الصوتية والحروف:
    يقوم السكربت بتحديث المعرّفات العشرية لكل حرف بشكل تراكمي بدون إدخال المتغير البشري لصوت المتحدث.
    """
    ternary_signal, sr = process_pure_word_signal(audio_path)
    phonemes_data = parse_speechscribe_times(txt_path)
    
    # محاولة تحميل قاعدة المعرفة السابقة للنموذج لتطويرها (تراكمياً)
    try:
        with open(database_file, 'r', encoding='utf-8') as f:
            model_db = json.load(f)
    except FileNotFoundError:
        model_db = {}
        
    print("⏳ جاري تحليل الإشارة البنيوية للكلمات وتحديث النموذج الحرفي...")
    
    for i in range(len(phonemes_data) - 1):
        start_time, phoneme = phonemes_data[i]
        end_time, _ = phonemes_data[i+1]
        
        # تجاهل الفراغات والرموز الهيكلية غير الحرفية
        if phoneme in ['_', '-']:
            continue
            
        start_idx = int(start_time * sr)
        end_idx = int(end_time * sr)
        
        # قص الغلاف الثلاثي الصرف للحرف الحركي الحالي
        phoneme_slice = ternary_signal[start_idx:end_idx]
        
        # حساب الرقم العشري الممثل للحرف (بدون تردد الحبال الصوتية)
        decimal_key = ternary_to_fixed_decimal(phoneme_slice, fixed_length=24)
        
        if phoneme not in model_db:
            model_db[phoneme] = []
            
        # إضافة المعرف العشري المكتشف إلى سجل هذا الحرف (إذا لم يكن مكرراً بشكل متطابق)
        if decimal_key not in model_db[phoneme]:
            model_db[phoneme].append(decimal_key)
            
    # حفظ قاعدة المعرفة المحدثة للنموذج في ملف JSON
    with open(database_file, 'w', encoding='utf-8') as f:
        json.dump(model_db, f, ensure_ascii=False, indent=4)
        
    print(f"✔️ تم تحديث وتطوير النموذج بنجاح وحفظ السجل في المجلد الحالي باسم: {database_file}")
    return model_db

# --- تشغيل عملية تدريب وتطوير النموذج الحركي ---
audio_file = "audio.wav"  # ملف الصوت الأصلي
times_file = "times.txt"   # ملف تفريغ الحروف والأوقات الأول

