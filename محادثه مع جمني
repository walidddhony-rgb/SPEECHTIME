        if path:
            self.audio_path = path
            self.lbl_audio.configure(text=os.path.basename(path), text_color="#F3F4F6")
            self.log(f"📁 تم ربط ملف إشارة الفيلم: {path}")

    def run_streaming_interpolation(self):
        if not self.audio_path:
            messagebox.showwarning("تنبيه", "الرجاء اختيار ملف الصوت أولاً!")
            return
            
        try:
            self.log("\n⏳ جاري عزل نبرة الصوت واستخراج غلاف الطاقة ثلاثياً...")
            ternary_signal, sr = get_pure_envelope(self.audio_path)
            
            self.log("🚀 بدء محاكاة خط الزمن الاستكمالي (Streaming Mode)...")
            
            # إعداد معاملات التدفّق اللحظي
            # نفترض نافذة زمنية متحركة قدرها 100 ملي ثانية للاستكمال الفوري
            window_size = int(0.100 * sr) 
            step_size = int(0.050 * sr) # خطوة القفز اللحظية (50 ملي ثانية)
            
            total_samples = len(ternary_signal)
            streaming_database = []
            
            current_idx = 0
            time_step_counter = 0
            
            # العدادات التراكمية اللحظية (المتغيرات الأساسية لمعادلتك)
            count_plus = 0
            count_minus = 0
            count_zero = 0
            
            while current_idx + window_size < total_samples:
                # اقتطاع الإشارة اللحظية في هذا الزمن بالتحديد
                slice_data = ternary_signal[current_idx : current_idx + window_size]
                
                # تحديث العدادات بشكل استكمالي تصاعدي بناءً على الحركة الحالية
                # (2 تعني صعود +، 0 تعني هبوط -، 1 تعني ثبات 0)
                step_plus = int(np.sum(slice_data == 2))
                step_minus = int(np.sum(slice_data == 0))
                step_zero = int(np.sum(slice_data == 1))
                
                # التجميع اللحظي للبيانات في هذا المقطع الزمني
                current_time_sec = current_idx / sr
                
                # طباعة أولى الخطوات الزمنية في الكونسول للمراقبة الفورية
                if time_step_counter % 20 == 0 and time_step_counter < 160:
                    self.log(f"🕒 الزمن [{current_time_sec:.3f} ثانية] -> التجميع الحالي: "
                             f"[{step_plus} صعود (+)، {step_minus} هبوط (-)، {step_zero} ثبات (0)]")
                elif time_step_counter == 160:
                    self.log("... [يتم معالجة بقية خط الإنتاج الزمني للمسلسل آلياً بكفاءة] ...")
                
                # حفظ التجميع الخاص بهذا الزمن في الذاكرة التراكمية
                streaming_database.append({
                    "time": current_time_sec,
                    "features": [step_plus, step_minus, step_zero]
                })
                
                current_idx += step_size
                time_step_counter += 1
                
            # حفظ مخرجات التجميع التدفيقي في ملف JSON جاهز للتحليل الرياضي والمربعات الصغرى
            with open(self.database_file, 'w', encoding='utf-8') as f:
                json.dump(streaming_database, f, indent=4)
                
            self.log(f"\n✔️ اكتملت عملية الاستكمال! تم توليد {time_step_counter} نقطة تجميع زمنية.")
            self.log(f"💾 تم حفظ الداتا التدفّقية الجاهزة لبناء المعادلات في: '{self.database_file}'")
            messagebox.showinfo("نجاح العملية", "تمت محاكاة الاستكمال التدفيقي وحفظ نقاط التجميع الزمنية بنجاح!")
            
        except Exception as e:
            self.log(f"❌ حدث خطأ أثناء التدفق اللحظي: {str(e)}")

