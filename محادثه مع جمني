import numpy as np
from scipy.io import wavfile
import json
import os

def run_direct_shift_elimination(audio_path, segment_ms=150, output_json="direct_clusters.json"):
    """
    تنفيذ خوارزمية التطابق الدقيق عبر الإزاحة المباشرة (Direct Matrix Shifting):
    - لا تستخدم FFT نهائياً.
    - تعتمد على الإزاحة الدورية (np.roll) خطوة بخطوة بمقدار 1000 كلوك بلس فقط.
    - حساب تجميع الطاقة وحذف المتطابقات تتابعياً.
    """
    # 1. تحميل الصوت وضبط قيمته من الصفر (حذف بصمة صوت المتحدث)
    sr, x = wavfile.read(audio_path)
    x = x.astype(np.float64)
    x += abs(x.min())
    
    total_samples = len(x)
    
    # حساب طول السقمنت (مثلاً 1000 سامبل تمثل الـ 1000 كلوك بلس)
    segment_size = int((segment_ms * sr) // 1000)
    
    print(f"🎬 حجم الملف الصوتي: {total_samples} سامبل.")
    print(f"📐 طول السقمنت المطلوبة (عدد خطوات الإزاحة): {segment_size} سامبل.")
    
    clusters = {}
    cluster_counter = 0
    
    # مصفوفة قناع لمتابعة العينات المتبقية والمحذوفة
    active_mask = np.ones(total_samples, dtype=np.int8)
    
    # استمرار المحرك حتى يتم تصفية الملف بالكامل وحذفه
    while np.sum(active_mask) > segment_size:
        
        # البحث عن أول مقطع نشط متبقٍ لم يُحذف بعد من بداية الملف
        active_indices = np.where(active_mask == 1)
        if len(active_indices) < segment_size:
            break
            
        start_idx = active_indices
        end_idx = start_idx + segment_size
        
        # قص السقمنت الحالية لتكون هي القالب (Target Segment)
        segment = x[start_idx:end_idx]
        self_similarity = np.sum(segment * segment) # طاقة النمط الذاتية
        
        if self_similarity == 0:
            active_mask[start_idx:end_idx] = 0
            continue
            
        # بناء مصفوفة تجميع لتخزين نتائج الـ 1000 خطوة (كلوك بلس)
        # أبعادها: (عدد عينات الملف × 1) لتجميع طاقة التطابق اللحظي
        total_matches = np.zeros(total_samples)
        
        # صناعة القالب المكرر على طول الملف بالكامل كما طلبت باستخدام np.tile
        num_repeats = (total_samples // segment_size) + 1
        tiled_signal = np.tile(segment, num_repeats)[:total_samples]
        
        # --- خطوة العبقرية: الإزاحة خطوة خطوة لـ 1000 كلوك بلس فقط ---
        # نقوم بتحريك المصفوفة المكررة عينة واحدة في كل دورة وحساب الضرب المباشر
        for shift in range(segment_size):
            # إزاحة مصفوفة القالب المكرر خطوة واحدة
            shifted_tile = np.roll(tiled_signal, shift)
            
            # الضرب المباشر في الإشارة النشطة (بدون معادلات معقدة أو FFT)
            match_energy = x * active_mask * shifted_tile
            
            # تراكم الطاقة اللحظية لتحديد نقاط التطابق الأعلى
            total_matches += match_energy

        # تحديد أكبر التطابقات التي تجاوزت عتبة الطاقة الذاتية للنمط
        match_threshold = 0.85 * self_similarity
        exact_match_indices = np.where(total_matches > match_threshold)
        
        if len(exact_match_indices) == 0:
            active_mask[start_idx:end_idx] = 0
            continue
            
        cluster_name = f"Phoneme_Cluster_{cluster_counter}"
        clusters[cluster_name] = []
        
        # --- خطوة النزول وحذف المتطابقات من المتغير الأصلي كلياً ---
        for idx in exact_match_indices:
            # تصفية النطاق الزمني بالكامل للحرف الذي تم قنصه
            actual_start = max(0, idx - (segment_size // 2))
            actual_end = min(total_samples, actual_start + segment_size)
            
            time_sec = actual_start / sr
            if time_sec not in clusters[cluster_name]:
                clusters[cluster_name].append(time_sec)
                
            # حذف المقاطع المتطابقة بتصفير القناع الخاص بها لمنع تداخلها مستقبلاً
            active_mask[actual_start:actual_end] = 0
            
        print(f"🎯 قنص مباشر [{cluster_name}] -> تم تصفية وحذف {len(exact_match_indices)} مقطعاً متطابقاً بإزاحة مصفوفية صرفة.")
        cluster_counter += 1
        
    # حفظ القاموس التصفوي النهائي في ملف JSON
    with open(output_json, 'w', encoding='utf-8') as f:
        json.dump(clusters, f, indent=4)
        
    print(f"\n✨ اكتملت العملية بالكامل! تم اختزال وتصفية الملف لـ {cluster_counter} فئة حرفية بدون أي معالجات معقدة.")

