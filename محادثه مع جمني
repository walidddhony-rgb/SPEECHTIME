from moviepy.editor import VideoFileClip
from speechscribe_ai_engine import extract_pure_word_signal, ternary_to_fixed_decimal # استدعاء الدوال من كودنا السابق

def extract_audio_from_video(video_path, output_wav_path="temp_movie_audio.wav"):
    """خطوة 1: فصل الصوت النقي من ملف الفيلم أو المسلسل وتوحيد التردد"""
    print(f"🎬 جاري معالجة فيديو الفيلم وفصل الصوت: {os.path.basename(video_path)}")
    video = VideoFileClip(video_path)
    # حفظ الصوت بتردد 16000 هرتز ومونو (قناة واحدة) وهو الأفضل لمعالجة الإشارات
    video.audio.write_audiofile(output_wav_path, fps=16000, nbytes=2, codec='pcm_s16le', ffmpeg_params=["-ac", "1"])
    return output_wav_path

def parse_srt_file(srt_path):
    """خطوة 2: تحليل ملف الـ SRT واستخراج النصوص والأوقات بالثواني"""
    subtitles = []
    # تعبير نمطي لقراءة أوقات SRT (00:00:02,160 --> 00:00:05,400)
    time_pattern = r"(\d+):(\d+):(\d+),(\d+)\s+-->\s+(\d+):(\d+):(\d+),(\d+)"
    
    with open(srt_path, 'r', encoding='utf-8') as f:
        content = f.read().split('\n\n')
        
    for chunk in content:
        lines = chunk.strip().split('\n')
        if len(lines) >= 3:
            time_match = re.search(time_pattern, lines[1])
            if time_match:
                # حساب وقت البداية والنهاية بالثواني
                t1 = time_match.groups()
                start_sec = int(t1[0])*3600 + int(t1[1])*60 + int(t1[2]) + int(t1[3])/1000.0
                end_sec = int(t1[4])*3600 + int(t1[5])*60 + int(t1[6]) + int(t1[7])/1000.0
                
                # دمج أسطر النص (في حال كانت الترجمة من سطرين) تنظيف النص من الرموز
                text = " ".join(lines[2:]).strip()
                # تنظيف النص من علامات التشكيل وحصر الحروف الصافية فقط
                text = re.sub(r'[^\w\s]', '', text)
                
                subtitles.append({'start': start_sec, 'end': end_sec, 'text': text})
                
    return subtitles

def auto_align_words_to_phonemes(subtitles, sr, ternary_signal, database_file="model_knowledge.json"):
    """
    خطوة 3 و 4: المحاذاة التلقائية الذكية (AI Alignment) 
    توزيع حروف جمل المسلسل على النسيج الثلاثي لغلاف الطاقة وتحديث النموذج فورا
    """
    try:
        with open(database_file, 'r', encoding='utf-8') as f:
            model_db = json.load(f)
    except FileNotFoundError:
        model_db = {}
        
    new_phonemes_counter = 0
    print("⏳ جاري تشغيل المحاذاة التلقائية وحصد الفونيمات من الترجمة...")
    
    for sub in subtitles:
        start_time = sub['start']
        end_time = sub['end']
        text = sub['text'].replace(" ", "") # إزالة الفراغات لمعالجة الحروف الصافية المتصلة صوتياً
        
        if not text:
            continue
            
        # حساب عدد عينات الإشارة الثلاثية لهذه الجملة
        total_duration = end_time - start_time
        start_idx = int(start_time * sr)
        end_idx = int(end_time * sr)
        
        # مصفوفة غلاف الطاقة الثلاثي المخصصة للجملة الحالية
        sentence_slice = ternary_signal[start_idx:end_idx]
        
        if len(sentence_slice) == 0:
            continue
            
        # تقسيم مصفوفة طاقة الجملة بالتساوي بناءً على عدد الحروف المتواجدة في ملف الـ SRT
        # (Linear forced alignment approximation)
        letter_chunks = np.array_split(sentence_slice, len(text))
        
        for idx, char in enumerate(text):
            phoneme_slice = letter_chunks[idx]
            
            # تحويل المقطع الحرفي المعزول من الفيلم إلى الرقم العشري الهيكل الخاص بك
            decimal_key = ternary_to_fixed_decimal(phoneme_slice, fixed_length=24)
            
            if char not in model_db:
                model_db[char] = []
            if decimal_key not in model_db[char]:
                model_db[char].append(decimal_key)
                new_phonemes_counter += 1
                
    # حفظ وتحديث قاعدة المعرفة
    with open(database_file, 'w', encoding='utf-8') as f:
        json.dump(model_db, f, ensure_ascii=False, indent=4)
        
    print(f"✔️ اكتمل الحصاد بنجاح! تم استخراج {new_phonemes_counter} بصمة فونيمية دون إدخال نبرة صوت الممثلين.")

def mine_data_from_movie(video_path, srt_path):
    """المحرك الرئيسي لتشغيل خط الإنتاج السريع"""
    # 1. عزل الصوت
    wav_path = extract_audio_from_video(video_path)
    
    # 2. قراءة الترجمة
    subtitles = parse_srt_file(srt_path)
    print(f"📋 تم رصد {len(subtitles)} جملة ترجمة داخل ملف الـ SRT.")
    
    # 3. معالجة الصوت الأصلي بالنظام الثلاثي للقمم العليا للكلمة (حذف صوت الممثل كلياً)
    print("🧠 جاري تشغيل خوارزميات قوقل ومعادلاتك الرياضية للتخلص من ترددات حبال الممثلين الصوتية...")
    ternary_signal, sr = extract_pure_word_signal(wav_path)
    
    # 4. التقطيع والتدريب الآلي السريع
    auto_align_words_to_phonemes(subtitles, sr, ternary_signal)
    
    # تنظيف الذاكرة وحذف ملف الصوت المؤقت للفيلم للحفاظ على مساحة جهازك
