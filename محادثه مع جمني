        # اختيار ملف الترجمة SRT
        self.btn_srt = ctk.CTkButton(controls_frame, text="📄 اختيار ملف الترجمة الأصلي (SRT)", command=self.select_srt, width=240, fg_color="#4B5563", hover_color="#374151", font=ctk.CTkFont(weight="bold"))
        self.btn_srt.grid(row=1, column=0, padx=20, pady=10, sticky="w")
        self.lbl_srt_path = ctk.CTkLabel(controls_frame, text="لم يتم اختيار ملف ترجمة بعد (اختياري للتسمية الآلية)...", text_color="#9CA3AF")
        self.lbl_srt_path.grid(row=1, column=1, sticky="w", padx=10)
        
        # شريط اختيار عتبة الاحتمالية (Similarity Threshold Slider)
        lbl_slider = ctk.CTkLabel(controls_frame, text="عتبة الاحتمالية (Threshold):", font=ctk.CTkFont(size=12, weight="bold"))
        lbl_slider.grid(row=2, column=0, padx=20, pady=15, sticky="e")
        
        self.slider_threshold = ctk.CTkSlider(controls_frame, from_=0.50, to=0.99, number_of_steps=49, command=self.update_slider_label, width=250)
        self.slider_threshold.set(0.85)
        self.slider_threshold.grid(row=2, column=1, sticky="w", padx=10, pady=15)
        
        self.lbl_slider_val = ctk.CTkLabel(controls_frame, text="0.85", font=ctk.CTkFont(weight="bold"), text_color="#38BDF8")
        self.lbl_slider_val.grid(row=2, column=1, padx=270, sticky="w", pady=15)
        
        # 3. زر التشغيل الأساسي للمنظومة التناقصية
        self.btn_run = ctk.CTkButton(self, text="⚡ تشغيل محرك الاحتماليات الموازي وبدء تصفية الفونيمات", 
                                      command=self.start_processing_thread, fg_color="#2563EB", hover_color="#1D4ED8", height=45, font=ctk.CTkFont(size=14, weight="bold"))
        self.btn_run.pack(padx=30, pady=10, fill="x")
        
        # 4. لوحة النتائج الفورية والسجلات (Console & Live Monitor)
        monitor_frame = ctk.CTkFrame(self, fg_color="transparent")
        monitor_frame.pack(pady=10, padx=30, fill="both", expand=True)
        
        # سجل العمليات المتسارع (Terminal Log)
        log_subframe = ctk.CTkFrame(monitor_frame, fg_color="#0F172A")
