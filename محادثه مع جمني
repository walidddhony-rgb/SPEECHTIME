import os
import numpy as np
import customtkinter as ctk
from tkinter import filedialog, messagebox
import matplotlib.pyplot as plt
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg

# استدعاء الدوال الرياضية من محرك المعالجة الضوئية
from core.optical_engine import simulate_optical_delay_line, run_multichannel_interference

# ضبط الثيم الاحترافي للواجهة الرسومية الضوئية
ctk.set_appearance_mode("Dark")
ctk.set_default_color_theme("green")  # اللون الأخضر ليتناسب مع الليزر البصري

class OpticalSimulatorGUI(ctk.CTk):
    def __init__(self):
        super().__init__()
        
        self.title("SpeechScribe AI - 100ns Analog Optical Processor Simulator")
        self.geometry("1100x800")
        
        self.audio_path = ""
        self.init_ui()

    def init_ui(self):
        # 1. الهيدر والتوثيق الأكاديمي لجذر الحوسبة التناظرية
