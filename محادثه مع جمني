        # جدول النتائج الفورية المستخلصة (Instant Results Viewer)
        results_subframe = ctk.CTkFrame(monitor_frame, fg_color="#1E293B", width=350)
        results_subframe.pack(side="right", fill="both", expand=False)
        results_subframe.pack_propagate(False)
        
        lbl_res = ctk.CTkLabel(results_subframe, text="✨ النتائج الفورية والتسمية الآلية للحروف:", font=ctk.CTkFont(size=12, weight="bold"), text_color="#F59E0B")
