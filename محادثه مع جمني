import numpy as np
from scipy.io import wavfile
from scipy.signal import hilbert, butter, filtfilt
import re

def butter_lowpass_filter(data, cutoff, fs, order=5):
    """مرشح لتنعيم الإشارة والاحتفاظ بالقمم العليا فقط واصطياد غلاف الطاقة"""
    nyq = 0.5 * fs
    normal_cutoff = cutoff / nyq
    b, a = butter(order, normal_cutoff, btype='low', analog=False)
    y = filtfilt(b, a, data)
    return y

def extract_energy_envelope(x, sr):
    """
    تحويل الإشارة الصوتية لتعتمد على القمم العليا وطاقة الكلمة فقط:
    1. أخذ القيمة المطلقة أو تحويل هيلبرت للحصول على القمم.
    2. تمرير الإشارة عبر مرشح منخفض لعزل النبرة الترددية البشريّة (Pitch).
    """
    # تحويل هيلبرت يستخرج الغلاف التحليلي اللحظي (Analytic Signal)
    analytic_signal = hilbert(x)
    amplitude_envelope = np.abs(analytic_signal)
    
    # تمرير الغلاف عبر مرشح منخفض (مثلاً بقيمة قطع 30 هرتز) 
    # هذا التردد المنخفض جداً كافٍ لالتقاط صعود وهبوط طاقة الكلمات فقط بدون نبرة الصوت البشري
    smooth_envelope = butter_lowpass_filter(amplitude_envelope, cutoff=30, fs=sr, order=4)
    
    # التأكد من عدم وجود قيم سالبة ناتجة عن الفلترة
    smooth_envelope[smooth_envelope < 0] = 0
    
    return smooth_envelope

def convert_to_ternary_envelope_signal(audio_path, output_wav_path=None):
    """
    إعادة تشكيل الإشارة الصوتية بناءً على القمم العليا وطاقتها 
    ثم تحويلها إلى النظام الثلاثي (0, 1, 2)
    """
    sr, x = wavfile.read(audio_path)
    x = x.astype(np.float64)
    
    # خطوة التحديث: استبدال الموجة الخام بغلاف القمم العليا فقط (طاقة الكلمة)
    x_envelope = extract_energy_envelope(x, sr)
    
    # معادلتك الأولى: الإزاحة لتبدأ من الصفر
    x_envelope += abs(x_envelope.min())
    
    # معادلتك الثانية: حساب إشارة الفرق (اتجاه حركة طاقة الكلمة: صعود، ثبات، هبوط)
    x1 = np.sign(np.roll(x_envelope, -1) - x_envelope)
    
    # حفظ ملف الصوت الجديد المستند إلى القمم العليا فقط
    if output_wav_path:
        # نقوم بعمل تشكيل موجي نقي للطاقة
        x2 = np.int16(x1 * (2**14))
        wavfile.write(output_wav_path, sr, x2)
        print(f"🎵 تم حفظ إشارة طاقة الكلمة الناتجة في: {output_wav_path}")
        
    # تحويل النظام إلى نظام ثلاثي بحت (0, 1, 2)
    ternary_signal = (x1 + 1).astype(np.int8)
    
    return ternary_signal, sr

def ternary_to_decimal_hash(ternary_array):
    """تحويل البنية الثلاثية لغلاف الفونيم إلى رقم عشري مميز لحركته الحجمية"""
    # نأخذ عينات ممثلة لغلاف الحركة (أبعاد ثابتة متناسبة مع طاقة الكلمة)
    step = max(1, len(ternary_array) // 20) 
    compressed_ternary = ternary_array[::step][:20]
    
    decimal_value = 0
    for power, digit in enumerate(reversed(compressed_ternary)):
        decimal_value += int(digit) * (3 ** power)
        
    return decimal_value

def parse_timestamps(txt_path):
    """قراءة الأوقات والفونيمات"""
    phonemes_data = []
    pattern = r"\[(\d+):(\d+):(\d+),(\d+)\]\s+time\s+(.+)"
    with open(txt_path, 'r', encoding='utf-8') as f:
        for line in f:
            match = re.match(pattern, line.strip())
            if match:
                hrs, mins, secs, ms, phoneme = match.groups()
                total_seconds = int(hrs)*3600 + int(mins)*60 + int(secs) + int(ms)/1000.0
                phonemes_data.append((total_seconds, phoneme.strip()))
    return phonemes_data

def build_envelope_database(audio_path, txt_path):
    """تجميع بصمات طاقة الفونيمات وتحويلها لأرقام عشرية مستقلة عن المتحدث"""
    ternary_signal, sr = convert_to_ternary_envelope_signal(audio_path, "envelope_signal.wav")
    phonemes_data = parse_timestamps(txt_path)
    
    phoneme_database = {}
    
    for i in range(len(phonemes_data) - 1):
        start_time, phoneme = phonemes_data[i]
        end_time, _ = phonemes_data[i+1]
        
        if phoneme in ['_', '-']:
            continue
            
        start_idx = int(start_time * sr)
        end_idx = int(end_time * sr)
        
        phoneme_ternary_slice = ternary_signal[start_idx:end_idx]
        
        if len(phoneme_ternary_slice) == 0:
            continue
            
        # تحويل نسيج غلاف الطاقة إلى رقم عشري
        decimal_key = ternary_to_decimal_hash(phoneme_ternary_slice)
        
        if phoneme not in phoneme_database:
            phoneme_database[phoneme] = []
        phoneme_database[phoneme].append(decimal_key)
        
    return phoneme_database

# --- تشغيل وتجربة النظام المطور القائم على القمم العليا ---
audio_file = "audio.wav"  
times_file = "times.txt"   

envelope_db = build_envelope_database(audio_file, times_file)

print("\n📊 المعرفات العشرية الناتجة بناءً على غلاف طاقة الكلمة (مستقلة عن صوت المتحدث):")
for phoneme, decimal_keys in envelope_db.items():
    print(f"الفونيم الإيقاعي [{phoneme}] -> الباركود العشري للطاقة: {int(np.mean(decimal_keys))}")
