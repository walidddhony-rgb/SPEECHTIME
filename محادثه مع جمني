import os
import re
import json

def parse_srt_to_timeline(srt_path):
    """تحليل ملف الـ SRT وتحويله إلى جدول زمني للحروف العربية الصافية"""
    if not os.path.exists(srt_path):
        return []
        
    subtitles = []
    time_pattern = r"(\d+):(\d+):(\d+),(\d+)\s+-->\s+(\d+):(\d+):(\d+),(\d+)"
    
    with open(srt_path, 'r', encoding='utf-8') as f:
        content = f.read().split('\n\n')
        
    for chunk in content:
        lines = chunk.strip().split('\n')
        if len(lines) >= 3:
            # البحث عن سطر التوقيت في أسطر هذا المقطع
            time_line = ""
            for line in lines:
                if "-->" in line:
                    time_line = line
                    break
            
            if time_line:
                time_match = re.search(time_pattern, time_line)
                if time_match:
                    t = time_match.groups()
                    start_sec = int(t[0])*3600 + int(t[1])*60 + int(t[2]) + int(t[3])/1000.0
                    end_sec = int(t[4])*3600 + int(t[5])*60 + int(t[6]) + int(t[7])/1000.0
                    
                    # استخراج نص الترجمة وتنظيفه
                    text_lines = [l for l in lines if not l.isdigit() and "-->" not in l]
                    text = " ".join(text_lines).strip()
                    text = re.sub(r'[^\u0600-\u06FF]', '', text) 
                    
                    if text:
                        subtitles.append({'start': start_sec, 'end': end_sec, 'text': text})
    return subtitles

def auto_label_dictionary(probabilities_json_path, srt_path, output_dictionary_path="final_speech_dictionary.json", log_callback=None):
    """
    قراءة ملف الاحتماليات ومطابقتها إحصائياً مع الـ SRT (نسخة الهامش اللين):
    إضافة نافذة سماحية تبلغ 0.5 ثانية لاقتناص كافة المجموعات الـ 27 وتسميتها تلقائياً.
    """
    if not os.path.exists(probabilities_json_path) or not os.path.exists(srt_path):
        if log_callback: log_callback("❌ خطأ: ملف الاحتماليات أو ملف الـ SRT غير موجود!")
        return False

    with open(probabilities_json_path, 'r', encoding='utf-8') as f:
        clusters_data = json.load(f)
        
    srt_timeline = parse_srt_to_timeline(srt_path)
    if not srt_timeline:
        if log_callback: log_callback("❌ خطأ: فشل استخراج نصوص الترجمة الزمنيّة من الـ SRT!")
        return False
        
    final_dictionary = {}
    if log_callback: log_callback("\n⏳ جاري بدء المطابقة الإحصائية المرنة وحصد الـ 27 فئة كاملة...")

    # 🌟 خطوة العبقرية: تحديد هامش أمان يبلغ نصف ثانية لامتصاص تفاوت توقيت الترجمة
    tolerance_seconds = 0.5

    for cluster_name, timestamps in clusters_data.items():
        letter_votes = {}
        
        for t_stamp in timestamps:
            for sub in srt_timeline:
                # توسيع النطاق زمنيّاً بالهامش اللين لضمان عدم إقصاء أي فئة
                if (sub['start'] - tolerance_seconds) <= t_stamp <= (sub['end'] + tolerance_seconds):
                    for char in sub['text']:
                        letter_votes[char] = letter_votes.get(char, 0) + 1
                        
        if letter_votes:
            true_letter = max(letter_votes, key=letter_votes.get)
            total_votes = sum(letter_votes.values())
            confidence = (letter_votes[true_letter] / total_votes) * 100
            
            final_dictionary[cluster_name] = {
                "assigned_letter": true_letter,
                "confidence_score": f"{confidence:.2f}%",
                "instances_found": len(timestamps)
            }
            if log_callback:
                log_callback(f"✔️ التسمية التلقائية بنجاح: [{cluster_name}] -> الحرف ({true_letter}) بثقة: {confidence:.2f}%")

    with open(output_dictionary_path, 'w', encoding='utf-8') as f:
        json.dump(final_dictionary, f, indent=4, ensure_ascii=False)
        
    if log_callback:
        log_callback(f"💾 تم إنقاذ القاموس وحفظ المعجم اللغوي المتكامل في: '{output_dictionary_path}'")
    return True
