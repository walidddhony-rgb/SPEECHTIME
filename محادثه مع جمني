import json
import re
import os
import numpy as np

def parse_srt_to_timeline(srt_path):
    """تحليل ملف الـ SRT وتحويله إلى جدول زمني للحروف"""
    if not os.path.exists(srt_path):
        print(f"❌ خطأ: لم يتم العثور على ملف الترجمة SRT في: {srt_path}")
        return []
        
    subtitles = []
    time_pattern = r"(\d+):(\d+):(\d+),(\d+)\s+-->\s+(\d+):(\d+):(\d+),(\d+)"
    
    with open(srt_path, 'r', encoding='utf-8') as f:
        content = f.read().split('\n\n')
        
    for chunk in content:
        lines = chunk.strip().split('\n')
        if len(lines) >= 3:
            time_match = re.search(time_pattern, lines[1])
            if time_match:
                t = time_match.groups()
                start_sec = int(t[0])*3600 + int(t[1])*60 + int(t[2]) + int(t[3])/1000.0
                end_sec = int(t[4])*3600 + int(t[5])*60 + int(t[6]) + int(t[7])/1000.0
                
                # تنظيف النص والاحتفاظ بالحروف العربية الصافية بدون فراغات
                text = " ".join(lines[2:]).strip()
                text = re.sub(r'[^\u0600-\u06FF]', '', text) # فلاتر الحروف العربية فقط
                
                if text:
                    subtitles.append({'start': start_sec, 'end': end_sec, 'text': text})
    return subtitles

def auto_label_clusters(json_path, srt_path, output_dictionary="final_speech_dictionary.json"):
    """
    الاستفادة من ملف الاحتماليات:
    مطابقة أوقات المجموعات المشفرة مع حروف الـ SRT لتسميتها تلقائياً.
    """
    if not os.path.exists(json_path):
        print(f"❌ خطأ: ملف الاحتماليات غير موجود: {json_path}")
        return

    # 1. تحميل أوقات المجموعات المستخرجة من واجهتك الرسومية
    with open(json_path, 'r', encoding='utf-8') as f:
        clusters_data = json.load(f)
        
    # 2. تحميل الجداول الزمنية للترجمة
    srt_timeline = parse_srt_to_timeline(srt_path)
    
    final_dictionary = {}
    print("⏳ جاري فحص ملف الاحتماليات والمطابقة الإحصائية مع الـ SRT...")

    for cluster_name, timestamps in clusters_data.items():
        letter_votes = {} # تصويت الحروف لرصد الحرف المهيمن على المجموعة
        
        for t_stamp in timestamps:
            # البحث عن الجملة التي قيلت في هذا التوقيت بالتحديد داخل الفيلم
            for sub in srt_timeline:
                if sub['start'] <= t_stamp <= sub['end']:
                    # توزيع حروف الجملة تقريبياً على هذه النافذة
                    # لرصد أي حرف يتكرر دائماً مع طاقة هذه المجموعة
                    for char in sub['text']:
                        letter_votes[char] = letter_votes.get(char, 0) + 1
                        
        if letter_votes:
            # اختيار الحرف صاحب أعلى نسبة تصويت وتكرار في هذا التوقيت
            true_letter = max(letter_votes, key=letter_votes.get)
            
            # حفظ الحرف في قاموس المعرفة النهائي المربوط بالـ 125ms
            final_dictionary[cluster_name] = {
                "assigned_letter": true_letter,
                "confidence_score": f"{(letter_votes[true_letter] / sum(letter_votes.values())) * 100:.2f}%",
                "instances_found": len(timestamps)
            }
            print(f"✔️ المجموعة [{cluster_name}] تندمج وتتحول تلقائياً إلى الحرف: ({true_letter}) بدقة ثقة: {final_dictionary[cluster_name]['confidence_score']}")

    # حفظ القاموس اللغوي النهائي
    with open(output_dictionary, 'w', encoding='utf-8') as f:
        json.dump(final_dictionary, f, indent=4, ensure_ascii=False)
        
    print(f"\n🌟 اكتملت الخطوة الثانية بنجاح! تم بناء القاموس اللغوي الخالي من الصوتيات في: '{output_dictionary}'")

