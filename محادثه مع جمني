    def run_optical_simulation(self):
        if not self.audio_path:
            messagebox.showwarning("تنبيه", "الرجاء اختيار ملف الصوت WAV التجريبي أولاً!")
            return
            
        self.btn_run.configure(state="disabled", text="⏳ جاري ضخ تيار الضوء وحساب تراكب القمم الضوئية...")
        self.txt_log.delete("1.0", "end")
        
        num_channels = int(self.slider_channels.get())
        
        try:
            from scipy.io import wavfile
            sr, x_raw = wavfile.read(self.audio_path)
            if len(x_raw.shape) > 1:
                x_raw = x_raw[:, 0]
                
            # تشغيل محرك التداخل الموجي التناظري التدرفقي الآمن للذاكرة العشوائية الفائقة
            self.log("💡 جاري معالجة تيار الضوء وتحويل عينات بايثون لخط زمن نانوي (10 MHz)...")
            self.log(f"⚙️ جاري تمرير النبضات في {num_channels} مسارات ألياف ضوئية بمضاعفات 20 متراً...")
            
            # استدعاء المحرك التكاملي الآمن الجديد كلياً
            results = run_multichannel_interference_safe(x_raw, sr, num_channels=num_channels, delay_ns=100)
            
            # 📊 طباعة تقرير الدقة المجهري والزوايا المضبوطة (TDOA Error Margin)
            self.log("\n📐 📋 --- تقرير الفحص الميكرومتري لـ Google AI ---")
            self.log(f"-> طول ليف القناة الفردية: {results['distance_per_channel_m']} متر (يقابل 100ns).")
            self.log(f"-> أبعاد مصفوفة المسارات متعددة الأطوال المحددة: {results['optical_waveguide_shape']}")
            self.log(f"-> حجم عينات التدفق الضوئي التناظري التقديري: {results['analog_stream_len']:,} كلوك.")
            
            # حساب وإبراز معدل خطأ الزوايا والموقع الفيزيائي
            error_m = results['micro_error_margin_m']
            self.log(f"-> نسبة الخطأ الميكانيكي للمخرج الصوتي: {error_m * 1000:.3f} ملي متر.")
            self.log(f"-> دقة الحساسية المكانية للزوايا: {error_m * 1000000:.1f} ميكرومتر (خارقة التلسكوبية).")
            self.log(f"-> عدد ومضات الوميض وقمم التطابق المقنوصة تراكمياً: {results['flash_timestamps_count']} ومضة.")
            self.log("-" * 45)
            
            # 📈 رسم منحنى التداخل الموجي الضوئي وغلاف الطاقة اللحظي
            self.ax.clear()
            env_data = results['interference_envelope']
            
            time_axis_ns = np.arange(len(env_data)) * 100 # النطاق بالنانو ثانية
            
            self.ax.plot(time_axis_ns, env_data, color="#10B981", alpha=0.85, label="غلاف تداخل الأمواج التناظري")
            
            threshold_val = 0.85 * np.max(env_data) if np.max(env_data) > 0 else 1.0
            self.ax.axhline(y=threshold_val, color="#EF4444", linestyle="--", alpha=0.7, label="عتبة بؤرة الوميض اللحظي")
            
            self.ax.set_title("Analog Wave Interference Envelope & Optical Peaks", color="white", fontweight="bold", fontsize=11)
            self.ax.set_xlabel("Time (Nanoseconds)", color="white", fontsize=10)
            self.ax.set_ylabel("Light Intensity Amplitude", color="white", fontsize=10)
            self.ax.grid(axis='both', alpha=0.15, linestyle='--')
            self.ax.legend(facecolor="#0F172A", edgecolor="#374151", labelcolor="white")
            
            self.canvas.draw()
            
            self.log("\n✨ اكتملت المحاكاة التناظرية الضوئية بنجاح ساحق!")
            messagebox.showinfo("نجاح المحاكاة", f"اكتملت المحاكاة! تم حساب تداخيل المسارات متعددة الأطوال بدقة مجهرية على مستوى الميكرومتر كلياً.")
            
        except Exception as e:
            self.log(f"❌ حدث خطأ في المحاكاة الضوئية: {str(e)}")
            messagebox.showerror("خطأ", f"فشلت المحاكاة الضوئية: {str(e)}")
            
        finally:
            self.btn_run.configure(state="normal", text="💡 تشغيل الليزر وحساب تداخل الأمواج بدقة 100ns")
