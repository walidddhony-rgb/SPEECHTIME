import numpy as np
from scipy.io import wavfile

def run_150ms_shrinkage_engine(audio_path, similarity_threshold=0.85, output_json="arabic_150ms_clusters.json"):
    """
    تنفيذ خوارزمية الغربلة والانكماش التناقصي لـ SpeechScribe (النسخة المصححة):
    - طول العينة مثبت عند 150 ملي ثانية.
    - إصلاح خطأ الـ TypeError في كبسولات NumPy الإندكسية.
    """
    if not os.path.exists(audio_path):
        print(f"❌ خطأ: لم يتم العثور على الملف الصوتي في المسار: {audio_path}")
        return

    # 1. قراءة الملف وتوحيد القناة الصوتية
    sr, x_raw = wavfile.read(audio_path)
    if len(x_raw.shape) > 1:
        x_raw = x_raw[:, 0]
        
    x = x_raw.astype(np.float64)
    x += abs(x.min()) # الإزاحة العلوية لتجريد نبرة صوت المتحدث
    
    initial_length = len(x)
    
    # 📏 تثبيت الطول بناءً على 150 ملي ثانية والـ Sample Rate
    segment_len = int((150 * sr) // 1000)
    
    print("=" * 65)
