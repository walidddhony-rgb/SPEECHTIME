        if len(matched_positions) > 0:
            x = x[keep_mask] # انكماش حجم الملف الصوتي فوراً في الذاكرة وضم بقية البايتات
            
            final_knowledge_base[cluster_name] = sorted(list(set(matched_positions)))
            shrinkage_percent = (1.0 - (len(x) / initial_length)) * 100
            
            print(f"🎯 [تصفية {cluster_name}]: تم إنزال الفونيم المتطابق وحذف مواقعه بالكامل.")
            print(f"📉 الإشارة المتبقية تنكمش إلى: {len(x):,} سامبل (نسبة التناقص الإجمالي: {shrinkage_percent:.2f}%).")
            print("-" * 70)
            
            cluster_counter += 1
        else:
            x = x[1:] # حماية التتابع التناقصي لمنع التوقف
            
    with open(output_json, 'w', encoding='utf-8') as f:
        json.dump(final_knowledge_base, f, indent=4, ensure_ascii=False)
        
    print("🌟 [اكتمل محرك جرد الاحتماليات لـ 125ms بنجاح تام] 🌟")
    print(f"💾 تم حفظ مخرجات المجموعات الغربالية في ملف الذاكرة: '{output_json}'")
