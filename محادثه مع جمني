    def log(self, message):
        self.txt_log.insert("end", message + "\n")
        self.txt_log.see("end")

    def log_result(self, cluster_name, count):
        self.txt_results.insert("end", f"▶️ {cluster_name}\n   المواضع المكتشفة: {count}\n\n")
        self.txt_results.see("end")

    def update_slider_label(self, val):
        self.lbl_slider_val.configure(text=f"{val:.2f}")

    def select_audio(self):
        path = filedialog.askopenfilename(filetypes=[("Audio WAV Files", "*.wav")])
        if path:
            self.audio_path = path
            self.lbl_audio_path.configure(text=os.path.basename(path), text_color="#F3F4F6")
            self.log(f"📁 تم ربط ملف إشارة الموجة الصوتية بنجاح: {path}")

    def select_srt(self):
        path = filedialog.askopenfilename(filetypes=[("Subtitle SRT Files", "*.srt")])
        if path:
            self.srt_path = path
            self.lbl_srt_path.configure(text=os.path.basename(path), text_color="#F3F4F6")
            self.log(f"📁 تم ربط ملف الترجمة بنجاح: {path}")

    def start_processing_thread(self):
        """تشغيل خوارزمية الحصاد في Thread منفصل لضمان مرونة وعدم تجميد الواجهة الرسومية"""
        if not self.audio_path:
            messagebox.showwarning("تنبيه", "الرجاء اختيار ملف الصوت WAV أولاً!")
            return
            
        self.btn_run.configure(state="disabled", text="⏳ جاري حساب المصفوفة الحركية وغربلة الفونيمات...")
        self.txt_results.delete("1.0", "end")
        
        threading.Thread(target=self.execute_engine_pipeline, daemon=True).start()

    def execute_engine_pipeline(self):
        threshold = self.slider_threshold.get()
        try:
            # 1. تشغيل النواة التناقصية وعزل المتطابقات
            self.log(f"\n🔮 بدء معالجة الإشارة المستهدفة بعتبة احتمالية: {threshold:.2f}")
            
            # استدعاء المحرك الصارم من الـ core
            final_clusters = run_125ms_shrinkage_core(
                audio_path=self.audio_path,
                similarity_threshold=threshold,
                log_callback=self.log,
                result_callback=self.log_result
            )
            
            # حفظ النتائج التجميعية الأولية في الـ JSON الجاهز
            with open(self.output_json, 'w', encoding='utf-8') as f:
                import json
                json.dump(final_clusters, f, indent=4, ensure_ascii=False)
            
            self.log(f"🌟 اكتملت الغربلة التناقصية بنجاح! تم اختزال الملف الصوتي.")
            
            # 2. خطوة التسمية الآلية التلقائية في حال إدخال ملف الـ SRT
            if self.srt_path:
                self.log("\n🎬 تم رصد ملف الـ SRT! بدء دمج الحروف الإحصائي والتعرف التلقائي...")
                success = auto_label_dictionary(self.output_json, self.srt_path, self.output_dict, log_callback=self.log)
                
                if success and os.path.exists(self.output_dict):
                    with open(self.output_dict, 'r', encoding='utf-8') as f:
                        dict_data = json.load(f)
                    
                    self.txt_results.delete("1.0", "end")
                    self.txt_results.insert("end", "✨ المعجم اللغوي المتولد تلقائياً:\n" + "="*30 + "\n\n")
                    for cl_name, details in dict_data.items():
                        self.txt_results.insert("end", f" الحرف المكتشف: {details['assigned_letter']}\n"
                                                       f"🔹 المجموعة: {cl_name}\n"
                                                       f"📊 نسبة الثقة: {details['confidence_score']}\n"
                                                       f"🔄 التكرار: {details['instances_found']}\n" + "-"*30 + "\n")
            
            messagebox.showinfo("نجاح كامل", "اكتملت الغربلة التناقصية والربط الإحصائي بنجاح تفرغي تام!")
            
        except Exception as e:
            self.log(f"❌ حدث خطأ غير متوقع أثناء الفرز الموازي: {str(e)}")
            messagebox.showerror("خطأ", f"فشلت المعالجة: {str(e)}")
            
        finally:
            self.btn_run.configure(state="normal", text="⚡ تشغيل محرك الاحتماليات الموازي وبدء تصفية الفونيمات")
