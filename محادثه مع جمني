import numpy as np

def extract_ternary_counts(ternary_slice):
    """
    تحويل الإشارة الثلاثية للحرف إلى 3 أرقام بسيطة فقط:
    [عدد الصعود (+)، عدد الهبوط (-)، عدد الثبات (0)]
    """
    if len(ternary_slice) == 0:
        return [0, 0, 0]
        
    # عد العناصر بناءً على قيمها في النظام الثلاثي الأصلي (2 تعني +، 0 تعني -، 1 تعني 0)
    count_plus  = int(np.sum(ternary_slice == 2))
    count_minus = int(np.sum(ternary_slice == 0))
    count_zero  = int(np.sum(ternary_slice == 1))
    
    # النتيجة هي المتجه الثلاثي البسيط الذي طلبته (البصمة الحجمية للحرف)
    return [count_plus, count_minus, count_zero]

# --- 🧪 مثال تطبيقي للفهم والتأكيد ---
