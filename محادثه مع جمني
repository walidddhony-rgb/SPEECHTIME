import os
import re
import json

def parse_srt_to_timeline(srt_path):
    """
    محلل الـ SRT المعياري الصارم:
    تفكيك ملف الترجمة بناءً على الصياغة القياسية للتوقيت، وضمان عزل كل جملة في وقتها الصافي.
    """
    if not os.path.exists(srt_path):
        return []
        
    subtitles = []
    # التعبير النمطي القياسي لقراءة خط التوقيت بالكامل في الـ SRT
    time_pattern = r"(\d{2}):(\d{2}):(\d{2}),(\d{3})\s+-->\s+(\d{2}):(\d{2}):(\d{2}),(\d{3})"
    
    with open(srt_path, 'r', encoding='utf-8') as f:
        # قراءة الملف ككتل منفصلة بناءً على السطور الفارغة
        chunks = f.read().replace('\r\n', '\n').split('\n\n')
        
    for chunk in chunks:
        lines = [line.strip() for line in chunk.split('\n') if line.strip()]
        if len(lines) < 2:
            continue
            
        time_line = ""
        text_start_idx = 2
        
        # البحث عن السطر الذي يحتوي على سهم التوقيت
        if "-->" in lines[0]:
            time_line = lines[0]
            text_start_idx = 1
        elif len(lines) > 1 and "-->" in lines[1]:
            time_line = lines[1]
            text_start_idx = 2
            
        if time_line:
            match = re.match(time_pattern, time_line)
            if match:
                g = match.groups()
                # حساب وقت البداية بدقة بالثواني والملي ثانية
                start_sec = int(g[0])*3600 + int(g[1])*60 + int(g[2]) + int(g[3])/1000.0
                # حساب وقت النهاية بدقة بالثواني والملي ثانية
                end_sec = int(g[4])*3600 + int(g[5])*60 + int(g[6]) + int(g[7])/1000.0
                
                # تجميع نص الترجمة وتنظيفه من الحروف غير العربية
                text_content = " ".join(lines[text_start_idx:])
                clean_text = re.sub(r'[^\u0600-\u06FF]', '', text_content)
                
                if clean_text:
                    subtitles.append({'start': start_sec, 'end': end_sec, 'text': clean_text})
                    
    return subtitles

def auto_label_dictionary(probabilities_json_path, srt_path, output_dictionary_path="final_speech_dictionary.json", log_callback=None):
    """
    قراءة ملف الاحتماليات ومطابقتها إحصائياً مع الـ SRT (النسخة المعيارية المصححة):
    إيجاد الحرف الحقيقي المهيمن لكل مجموعة بناءً على التوقيت الصافي الصارم.
    """
    if not os.path.exists(probabilities_json_path) or not os.path.exists(srt_path):
        if log_callback: log_callback("❌ خطأ: ملف الاحتماليات أو ملف الـ SRT غير موجود!")
        return False

    with open(probabilities_json_path, 'r', encoding='utf-8') as f:
        clusters_data = json.load(f)
        
    srt_timeline = parse_srt_to_timeline(srt_path)
    if not srt_timeline:
        if log_callback: log_callback("❌ خطأ: لم يتم العثور على ترجمة صالحة. تأكد من صياغة ملف الـ SRT!")
        return False
        
    final_dictionary = {}
    if log_callback: log_callback("\n⏳ جاري بدء المطابقة الإحصائية الصارمة لمنع تكرار النسب والعمليات الهجينة...")

    # نافذة سماحية مرنة مطابقة للمسلسلات
    tolerance_seconds = 0.3

    for cluster_name, timestamps in clusters_data.items():
        letter_votes = {}
        
        for t_stamp in timestamps:
            for sub in srt_timeline:
                # التحقق الصارم من وقوع السامبل ضمن وقت الجملة الفعلية
                if (sub['start'] - tolerance_seconds) <= t_stamp <= (sub['end'] + tolerance_seconds):
                    for char in sub['text']:
                        letter_votes[char] = letter_votes.get(char, 0) + 1
                        
        if letter_votes:
            # اقتناص الحرف الفعلي صاحب أعلى تكرار
            true_letter = max(letter_votes, key=letter_votes.get)
            total_votes = sum(letter_votes.values())
            confidence = (letter_votes[true_letter] / total_votes) * 100
            
            final_dictionary[cluster_name] = {
                "assigned_letter": true_letter,
                "confidence_score": f"{confidence:.2f}%",
                "instances_found": len(timestamps)
            }
            if log_callback:
                log_callback(f"✔️ [{cluster_name}] -> تم الفرز والتسمية: الحرف ({true_letter}) بثقة: {confidence:.2f}%")

    with open(output_dictionary_path, 'w', encoding='utf-8') as f:
