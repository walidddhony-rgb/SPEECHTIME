            multiplication_result = x_slice * tiled_pattern
            reshaped_matrix = multiplication_result.reshape(num_blocks, segment_len)
            
            # جمع طاقة المقاطع لمطابقتها مع طاقة عينة الـ 150ms الأصلية
            block_sums = np.sum(reshaped_matrix, axis=1)
            matched_block_indices = np.where(block_sums >= (similarity_threshold * segment_energy))[0] # [0] تم الإصلاح هنا
            
            # استخراج الأرقام الصحيحة كـ Scalars لتجنب خطأ الـ TypeError
            for b_idx in matched_block_indices:
                actual_start_pos = int(shift + (b_idx * segment_len))
                actual_end_pos = int(actual_start_pos + segment_len)
                
                keep_mask[actual_start_pos:actual_end_pos] = False
                matched_positions.append(actual_start_pos / sr)
                
        # --- خطوة الحذف الفعلي والانكماش الديناميكي المتسارع الحقيقي ---
        if len(matched_positions) > 0:
            x = x[keep_mask] # انكماش حجم الملف الصوتي وضمه برمجياً في الذاكرة
            
            final_knowledge_base[cluster_name] = sorted(list(set(matched_positions)))
            shrinkage_percent = (1.0 - (len(x) / initial_length)) * 100
            
            print(f"🎯 [تصفية {cluster_name}]: تم قنص وحذف المتطابقات في خط الزمن.")
            print(f"📉 حجم الإشارة المتبقية ينكمش متسارعاً إلى: {len(x):,} سامبل (تصفية: {shrinkage_percent:.2f}%).")
            print("-" * 65)
            
            cluster_counter += 1
        else:
            x = x[1:] # حماية التتابع التناقصي
            
    with open(output_json, 'w', encoding='utf-8') as f:
        json.dump(final_knowledge_base, f, indent=4, ensure_ascii=False)
        
