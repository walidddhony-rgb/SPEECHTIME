import numpy as np
import librosa
from scipy.io import wavfile
import re

def convert_to_ternary_signal(audio_path, output_wav_path=None):
    """
    1. تحميل الصوت كمصفوفة نمباي
    2. تطبيق تحويل النظام الثلاثي (0, 1, 2) بناءً على الفروقات اللحظية
    3. حفظ نسخة نقية (إشاريّة) من الصوت إذا طُلب ذلك
    """
    # تحميل الصوت الأصلي بتردد ثابت (مثلاً 16000 هرتز لجعل السلاسل الزمنية متناسقة)
    sr, x = wavfile.read(audio_path)
    
    # تحويل الصوت إلى مصفوفة float64 لتجنب مشاكل الـ Overflow أثناء العمليات الرياضية
    x = x.astype(np.float64)
    
    # معادلتك الأولى: إزاحة الصوت لتبدأ من الصفر (إلغاء القيم السالبة)
    x += abs(x.min())
    
    # معادلتك الثانية: حساب إشارة الفرق بين كل عينة والعينة التالية (Delta Sign)
    # np.roll(x, -1) يجلب العينة التالية، وطرح x منها يعطي اتجاه الحركة (صعود أو هبوط)
    x1 = np.sign(np.roll(x, -1) - x)
    
    # حفظ الملف الصوتي النقي جداً (الإشاري) كما طلبت
    if output_wav_path:
        x2 = np.int16(x1 * (2**14))
        wavfile.write(output_wav_path, sr, x2)
        print(f"🎵 تم حفظ ملف الصوت النقي (الإشاري) في: {output_wav_path}")
    
    # تحويل النظام إلى نظام ثلاثي بحت (0, 1, 2) بإضافة 1 إلى مصفوفة الإشارات
    # حيث: الهبوط الصوتي (-1) يصبح 0، الثبات اللحظي (0) يصبح 1، والصعود الصوتي (1) يصبح 2
    ternary_signal = (x1 + 1).astype(np.int8)
    
    return ternary_signal, sr

def ternary_to_decimal(ternary_array):
    """
    تحويل مصفوفة النظام الثلاثي (0, 1, 2) الخاصة بالفونيم إلى رقم عشري فريد.
    ملاحظة رياضية: لحماية الذاكرة من التدفق (Overflow) عند قراءة مقاطع طويلة، 
    نقوم بتقليل الأبعاد عبر قراءة العينات بشكل دوري (Downsampling) أو تحويلها لقيمة الهاش (Hash).
    """
    # للحصول على رقم عشري دقيق وثابت الطول لكل الفونيمات، نأخذ عينة لكل N خطوة
    # لأن تحويل مصفوفة طولها 4000 عينة بنظام أساسه 3 ينتج رقماً ضخماً جداً لا تستوعبه الذاكرة
    step = max(1, len(ternary_array) // 15) # تقليص الطول إلى 15 عينة مميزة للفونيم
    compressed_ternary = ternary_array[::step][:15]
    
    decimal_value = 0
    for power, digit in enumerate(reversed(compressed_ternary)):
        decimal_value += int(digit) * (3 ** power)
        
    return decimal_value

def parse_timestamps(txt_path):
    """قراءة الأوقات والفونيمات من الملف الذي أنتجه المشروع"""
    phonemes_data = []
    pattern = r"\[(\d+):(\d+):(\d+),(\d+)\]\s+time\s+(.+)"
    
    with open(txt_path, 'r', encoding='utf-8') as f:
        for line in f:
            match = re.match(pattern, line.strip())
            if match:
                hrs, mins, secs, ms, phoneme = match.groups()
                total_seconds = int(hrs)*3600 + int(mins)*60 + int(secs) + int(ms)/1000.0
                phonemes_data.append((total_seconds, phoneme.strip()))
    return phonemes_data

def extract_and_index_phonemes(audio_path, txt_path):
    """تجميع الفونيمات وتحويل نسيجها الثلاثي إلى رقم عشري"""
    ternary_signal, sr = convert_to_ternary_signal(audio_path, "pure_signal.wav")
    phonemes_data = parse_timestamps(txt_path)
    
    phoneme_database = {}
    
    for i in range(len(phonemes_data) - 1):
        start_time, phoneme = phonemes_data[i]
        end_time, _ = phonemes_data[i+1]
        
        # تخطي الفراغات والسكتات
        if phoneme in ['_', '-']:
            continue
            
        # تحويل الوقت إلى مؤشرات (Indices) داخل مصفوفة النظام الثلاثي
        start_idx = int(start_time * sr)
        end_idx = int(end_time * sr)
        
        # استخراج البنية الثلاثية للفونيم الحالي
        phoneme_ternary_slice = ternary_signal[start_idx:end_idx]
        
        if len(phoneme_ternary_slice) == 0:
            continue
            
        # تحويل النظام الثلاثي للفونيم الحالي إلى رقم عشري فريد
        decimal_key = ternary_to_decimal(phoneme_ternary_slice)
        
        # إضافة الفونيم للقاموس البرمجي
        if phoneme not in phoneme_database:
            phoneme_database[phoneme] = []
        phoneme_database[phoneme].append(decimal_key)
        
    return phoneme_database

# --- تشغيل البرنامج ---
# ضع ملفاتك هنا للتجربة
audio_file = "audio.wav"  # ملف الصوت الأصلي الخاص بك (يجب أن يكون بتنسيق WAV)
times_file = "times.txt"   # ملف الأوقات الذي أرسلته لي

database = extract_and_index_phonemes(audio_file, times_file)

# طباعة النتائج واستعراض الباركود العشري لكل فونيم
print("\n🎯 تم استخراج القيمة العشرية الفريدة (المعرف الثلاثي) للفونيمات:")
for phoneme, decimal_keys in database.items():
    # نأخذ متوسط القيم أو نستعرض أول قيمة تم التعرف عليها للحرف
    print(f"الحرف البصري [{phoneme}] -> يمثله الرقم العشري الثابت: {int(np.mean(decimal_keys))}")
