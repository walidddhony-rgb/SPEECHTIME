import numpy as np
import joblib

def predict_phoneme_via_equation(decimal_key, model_output_file="predictive_weights.pkl"):
    """
    استخدام المعادلة الرياضية التنبئية مباشرة للتنبؤ بالحرف بناءً على الرقم العشري
    المعايير مستندة على الأوزان المحسوبة فقط: y = W * x + B
    """
    # تحميل الأوزان والثوابت فقط
    model_data = joblib.load(model_output_file)
    W = model_data['weights']
    B = model_data['biases']
    classes = model_data['classes']
    
    # تطبيق المعادلة الخطية للتنبؤ: حساب النقاط (Scores) لكل حرف
    # x هنا هو الرقم العشري للفونيم الجديد
    x = float(decimal_key)
    
    # حساب قيم الاحتمالية لكل الحروف المتواجدة في قاعدة المعرفة
    scores = np.dot(W, np.array([[x]])) + B.reshape(-1, 1)
    
    # الحرف صاحب أعلى قيمة هو الحرف الصحيح المتنبأ به
    predicted_index = np.argmax(scores)
    return classes[predicted_index]

# --- مثال على التنبؤ اللحظي وسرعته ---
