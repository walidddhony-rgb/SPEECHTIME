            self.lbl_path.configure(text=os.path.basename(path), text_color="#F3F4F6")
            self.log(f"📁 تم ربط ملف إشارة الموجة الصوتية بنجاح: {path}")

    def run_probability_shrinkage(self):
        if not self.audio_path:
            messagebox.showwarning("تنبيه", "الرجاء اختيار ملف الصوت WAV أولاً!")
            return
            
        # تغيير حالة الزر أثناء المعالجة لحماية التوازي ومؤشرات الذاكرة
        self.btn_run.configure(state="disabled", text="⏳ جاري حساب المصفوفة الحركية وغربلة الفونيمات...")
        self.txt_results.delete("1.0", "end")
        
        threshold = self.slider_threshold.get()
        
        try:
            self.log(f"\n🔮 بدء معالجة الإشارة المستهدفة بعتبة احتمالية: {threshold:.2f}")
            sr, x_raw = wavfile.read(self.audio_path)
            
            if len(x_raw.shape) > 1:
                x_raw = x_raw[:, 0]
                
            x = x_raw.astype(np.float64)
            x += abs(x.min()) # الإزاحة النسبية من الصفر لعزل البصمة الترددية للمتحدث
            
            initial_length = len(x)
            segment_len = int((125 * sr) // 1000) # حساب عينة الـ 125ms الدقيقة في الذاكرة
            
            self.log(f"🎬 إجمالي عينات الملف البدائية: {initial_length:,} سامبل.")
            self.log(f"📐 طول نافذة الـ 125ms الثابتة: {segment_len:,} سامبل.")
            self.log("-" * 50)
            
            final_knowledge_base = {}
            cluster_counter = 0
            
            # المحرك التناقصي الخيالي المستند إلى فكرتك التنافسية
            while len(x) >= segment_len:
                segment = x[:segment_len]
                segment_energy = np.sum(segment * segment)
                
                if segment_energy == 0:
                    x = x[segment_len:] # انكماش فوري متبوع بتخطي الصمت المطلق
                    continue
                    
                cluster_name = f"Phoneme_Cluster_{cluster_counter}"
                keep_mask = np.ones(len(x), dtype=bool)
                matched_positions = []
                
                # التحريك خطوة بخطوة بعدد خانات يساوي طول السامبل (125ms) لمسح الملف مصفوفياً
                for shift in range(segment_len):
                    available_len = len(x) - shift
                    num_blocks = available_len // segment_len
                    truncated_len = num_blocks * segment_len
                    
                    if num_blocks == 0:
                        continue
                        
                    tiled_pattern = np.tile(segment, num_blocks)
                    x_slice = x[shift : shift + truncated_len]
                    
                    multiplication_result = x_slice * tiled_pattern
                    reshaped_matrix = multiplication_result.reshape(num_blocks, segment_len)
                    
                    block_sums = np.sum(reshaped_matrix, axis=1)
                    block_probabilities = block_sums / segment_energy
                    
                    matched_block_indices = np.where(block_probabilities >= threshold)
                    
                    # استخراج وتصحيح المؤشرات الرياضية Scalars لمنع الـ TypeError المكتشف سابقاً
                    for b_idx in matched_block_indices[0]:
                        actual_start_pos = int(shift + (b_idx * segment_len))
                        actual_end_pos = int(actual_start_pos + segment_len)
                        
                        keep_mask[actual_start_pos:actual_end_pos] = False
                        matched_positions.append(actual_start_pos / sr)
                        
                # خطوة الحذف الفعلي والانكماش المستمر (Dynamic Compacting)
                if len(matched_positions) > 0:
                    x = x[keep_mask] # قص الحروف المتطابقة ودمج باهتة البيانات المتبقية فوراً
                    
                    final_knowledge_base[cluster_name] = sorted(list(set(matched_positions)))
                    shrinkage_percent = (1.0 - (len(x) / initial_length)) * 100
                    
                    # التحديث اللحظي على الواجهة الرسومية لراحة المستخدم
                    self.log(f"🎯 [تصفية {cluster_name}]: تم عزل المتطابقات بنجاح.")
                    self.log(f"📉 المصفوفة تنكمش إلى: {len(x):,} سامبل (تصفية: {shrinkage_percent:.2f}%).")
                    self.log("-" * 50)
                    
                    # عرض الفئة الناتجة فوراً في جدول النتائج الجانبي
                    self.txt_results.insert("end", f"▶️ {cluster_name}\n   المواقع المكتشفة: {len(final_knowledge_base[cluster_name])}\n\n")
                    self.txt_results.see("end")
                    
                    cluster_counter += 1
