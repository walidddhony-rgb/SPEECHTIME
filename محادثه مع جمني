import json
import os

class SpeechScribeLookupEngine:
    def __init__(self, database_file="model_knowledge.json"):
        self.database_file = database_file
        self.lookup_table = {}
        self.load_table()

    def load_table(self):
        """تحميل القاموس المباشر للحروف والأرقام"""
        if os.path.exists(self.database_file):
            with open(self.database_file, 'r', encoding='utf-8') as f:
                # تحميل الداتا التراكمية (الحرف متبوعاً بقائمة أرقامه العشرية)
                raw_db = json.load(f)
                
            # عكس القاموس ليكون البحث سريعا جداً (الرقم العشري -> الحرف المقابل)
            self.lookup_table = {}
            for phoneme, decimal_keys in raw_db.items():
                for key in decimal_keys:
                    self.lookup_table[int(key)] = phoneme
            print(f"✅ تم بناء جدول البحث السريع بنجاح! يحتوي على {len(self.lookup_table)} بصمة رقمية مباشرة.")
        else:
            print("⚠️ لم يتم العثور على قاعدة بيانات بعد. القاموس الحالي فارغ.")

    def predict_instant(self, new_decimal_key):
        """
        البحث اللحظي السريع جداً بدون معادلات (Direct Lookup)
        فلسفة مشروع SpeechScribe الصرفة.
        """
        key = int(new_decimal_key)
        
        # 1. مطابقة مباشرة وصارمة (Exact Match)
        if key in self.lookup_table:
            return self.lookup_table[key]
            
        # 2. إذا لم يجد تطابقاً حرفياً (حماية إضافية عبر إيجاد أقرب رقم في الجدول)
        # هذه الخطوة تعمل كممتص للصدمات في حال اختلف نطق الحرف طفيفاً
        if self.lookup_table:
            all_keys = np.array(list(self.lookup_table.keys()))
            closest_key = all_keys[np.argmin(np.abs(all_keys - key))]
            return self.lookup_table[closest_key]
            
        return "❓"

# --- تجربة التشغيل اللحظي السريع ---
