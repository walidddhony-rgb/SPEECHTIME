import numpy as np

def run_pure_shrinkage_algorithm(audio_data, segment_len=2, similarity_threshold=0.90):
    """
    تنفيذ خوارزمية التصفية والانكماش الحركية الخالصة بناءً على منطقك:
    - تكرار السقمنت عبر الطول بالكامل.
    - التحريك بخانة واحدة فقط لتغطية كافة النقاط.
    - حذف العناصر المتطابقة فعلياً وانكماش مصفوفة x وتحديثها.
    """
    # تحويل البيانات إلى مصفوفة نمباي ديناميكية من نوع float64
    x = np.array(audio_data, dtype=np.float64)
    
    cluster_counter = 0
    result_clusters = {}
    
    print(f"🎬 المصفوفة الأصلية البدائية x: {x.astype(int).tolist()}")
    print(f"📐 طول السقمنت المستهدف: {segment_len}\n")
    
    # تستمر الحلقة حتى يصبح طول المصفوفة المتبقية أقل من طول السقمنت
    while len(x) >= segment_len:
        
        # 1. اقتطاع السقمنت الحالية من بداية الملف المتبقي دائماً
        segment = x[:segment_len]
        segment_sum_sq = np.sum(segment * segment) # القيمة المرجعية للتطابق الذاتي
        
        if segment_sum_sq == 0:
            x = x[segment_len:] # تخطي الأصفار المطلقة والانكماش
            continue
            
        cluster_name = f"Group_{cluster_counter} ({list(segment.astype(int))})"
        result_clusters[cluster_name] = []
        
        # مصفوفة لتسجيل المؤشرات (Indices) التي ثبت تطابقها لحذفها لاحقاً
        indices_to_remove = set()
        
        # --- خطوة العبقرية: التحريك بعدد خانات يساوي طول السقمنت فقط (مثلاً خانتين 0 و 1) ---
        for shift in range(segment_len):
            
            # حساب الطول المتاح للقسمة المقبولة على طول السقمنت بناءً على الإزاحة الحالية
            available_len = len(x) - shift
            num_blocks = available_len // segment_len
            truncated_len = num_blocks * segment_len
            
            if num_blocks == 0:
                continue
                
            # بناء القناع المكرر x1 باستخدام np.tile وتكييفه مع الإزاحة الحالية
            tiled_pattern = np.tile(segment, num_blocks)
            
            # تجهيز شريحة x المقابلة للإزاحة والضرب المباشر
            x_slice = x[shift : shift + truncated_len]
            
            # إجراء عملية الضرب النقطي الموازي: x * x1
            multiplication_result = x_slice * tiled_pattern
            
            # إعادة التشكيل (Reshape) لتصبح الأبعاد: (عدد الكتل × طول السقمنت)
            reshaped_matrix = multiplication_result.reshape(num_blocks, segment_len)
            
            # إجراء عملية الجمع لكل بلوك (المجاميع الناتجة)
            block_sums = np.sum(reshaped_matrix, axis=1)
            
            # تحديد البلوكات المتشابهة التي تطابق طاقة السقمنت الأصلية
            # (نستخدم نسبة سماحية خفيفة 90% للتعامل مع الفروق الطفيفة في المسلسلات)
            matched_blocks = np.where(block_sums >= (similarity_threshold * segment_sum_sq))[0]
            
            # تحديد مواقع المؤشرات الفعلية المتطابقة داخل المصفوفة x لحذفها
            for block_idx in matched_blocks:
                actual_start_pos = shift + (block_idx * segment_len)
                # تسجيل نقاط الحذف الفعلي
                for pos in range(actual_start_pos, actual_start_pos + segment_len):
                    indices_to_remove.add(pos)
                    
        # --- خطوة الحذف الفعلي والانكماش (Dynamic Compacting) ---
        if indices_to_remove:
            # الاحتفاظ فقط بالعناصر التي لم يتم رصد تطابقها
            all_indices = np.arange(len(x))
            keep_mask = np.invert(np.isin(all_indices, list(indices_to_remove)))
            
            # تسجيل المواقع المقنوصة قبل الحذف
            result_clusters[cluster_name] = sorted(list(indices_to_remove))
            
            # انكماش المصفوفة x وتحديثها كلياً لتصبح أصغر ومستعدة للدورة التالية
            x = x[keep_mask]
            
            print(f"🎯 قنص ممتع وتم حذف المتطابقات!")
            print(f"🔄 مصفوفة x المتبقية بعد الانكماش والتصفية: {x.astype(int).tolist()}")
            cluster_counter += 1
        else:
            # حماية في حال عدم وجود أي تطابق (تخطي أول عنصر والانكماش)
            x = x[1:]
            
    return result_clusters

