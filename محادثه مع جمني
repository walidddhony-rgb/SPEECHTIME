    print("-" * 65)

    final_knowledge_base = {}
    cluster_counter = 0
    
    while len(x) >= segment_len:
        
        # اقتطاع عينة الـ 150ms الحالية من بداية الملف المنكمش
        segment = x[:segment_len]
        segment_energy = np.sum(segment * segment)
        
        if segment_energy == 0:
            x = x[segment_len:] # انكماش فوري وتجاوز الصمت
            continue
            
        cluster_name = f"Letter_Cluster_{cluster_counter}"
        keep_mask = np.ones(len(x), dtype=bool)
        matched_positions = []
        
        # --- التحريك خطوة بخطوة بعدد خانات يساوي طول عينة الـ 150ms فقط ---
        for shift in range(segment_len):
            available_len = len(x) - shift
            num_blocks = available_len // segment_len
            truncated_len = num_blocks * segment_len
            
            if num_blocks == 0:
