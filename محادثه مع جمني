import os
import numpy as np
from scipy.io import wavfile
from scipy.signal import hilbert, butter, filtfilt

def butter_lowpass_filter(data, cutoff, fs, order=4):
    """مرشح لتنعيم غلاف الطاقة وعزل ترددات الحبال الصوتية المرتفعة"""
    nyq = 0.5 * fs
    normal_cutoff = cutoff / nyq
    b, a = butter(order, normal_cutoff, btype='low', analog=False)
    return filtfilt(b, a, data)

def extract_pure_125ms_envelope(audio_path):
    """
    تحليل الموجة الصوتية ثلاثياً:
    1. عزل نبرة صوت المتحدث (بصمة الـ Pitch) عبر غلاف هيلبرت والمرشح المنخفض.
    2. تحويل الإشارة إلى نظام ثلاثي حركي لحظي (0, 1, 2) يعبر عن طاقة مخارج الكلمة.
    """
    sr, x = wavfile.read(audio_path)
    
    # إذا كان الملف ستيريو، نكتفي بقناة واحدة لتسريع العمليات المصفوفة
    if len(x.shape) > 1:
        x = x[:, 0]
        
    x = x.astype(np.float64)
    
    # الإزاحة النسبية من الصفر كخطوة تصفية بدائية ثابتة
    x += abs(x.min())
    
    # استخراج القمم العليا (غلاف الطاقة الخارجي للكلمة)
    analytic_signal = hilbert(x)
    amplitude_envelope = np.abs(analytic_signal)
    
    # تصفية الترددات البشرية عند 25 هرتز لالتقاط حركة النطق العضوية فقط
    word_structure_signal = butter_lowpass_filter(amplitude_envelope, cutoff=25, fs=sr, order=4)
    word_structure_signal += abs(word_structure_signal.min())
    
    # معادلتك الرياضية المبتكرة: حساب اتجاه حركة الطاقة (صعود +1، ثبات 0، هبوط -1)
    diff_signal = np.sign(np.roll(word_structure_signal, -1) - word_structure_signal)
    
    # التحويل للنظام الثلاثي النقي (0, 1, 2)
    ternary_signal = (diff_signal + 1).astype(np.int8)
    
    return ternary_signal, sr

def run_125ms_shrinkage_core(audio_path, similarity_threshold=0.85, log_callback=None, result_callback=None):
    """
    النواة التناقصية المتسارعة الخيالية:
    - حساب الاحتماليات مصفوفياً وموازياً على مستوى الـ 125ms (2000 كلوك بلس).
    - قنص المتطابقات وحذف مواقعها كلياً لتنكمش المصفوفة وتتضاعف السرعة هندسياً.
    """
    if not os.path.exists(audio_path):
        if log_callback: log_callback("❌ خطأ: لم يتم العثور على ملف الصوت!")
        return {}

    # استخراج الإشارة الثلاثية النقية لغلاف طاقة الكلمة
    ternary_signal, sr = extract_pure_125ms_envelope(audio_path)
    
    initial_length = len(ternary_signal)
    # 📏 تثبيت النافذة بدقة عند 125 ملي ثانية
    segment_len = int((125 * sr) // 1000)
    
    if log_callback:
        log_callback(f"🎬 إجمالي عينات الملف البدائية: {initial_length:,} سامبل.")
        log_callback(f"📐 طول نافذة الـ 125ms الثابتة: {segment_len:,} سامبل (كلوك بلس).")
        log_callback("-" * 50)

    final_knowledge_base = {}
    cluster_counter = 0
    
    # نسخ الإشارة الثلاثية لبدء عملية الغربلة التناقصية المستمرة عليها
    x = np.copy(ternary_signal)
    
    while len(x) >= segment_len:
        segment = x[:segment_len]
        segment_energy = np.sum(segment * segment)
        
        if segment_energy == 0:
            x = x[segment_len:] # انكماش فوري عند رصد الصمت
            continue
            
        cluster_name = f"Phoneme_Cluster_{cluster_counter}"
        keep_mask = np.ones(len(x), dtype=bool)
        matched_positions = []
        
        # التحريك خطوة بخطوة بعدد خانات يساوي طول السامبل (125ms) لمسح الملف بالكامل
        for shift in range(segment_len):
            available_len = len(x) - shift
            num_blocks = available_len // segment_len
            truncated_len = num_blocks * segment_len
            
            if num_blocks == 0:
                continue
                
            # بناء القالب المكرر المتوازي في الذاكرة بلمح البصر (np.tile)
            tiled_pattern = np.tile(segment, num_blocks)
            x_slice = x[shift : shift + truncated_len]
            
            # الضرب المصفوفي النقي في الذاكرة العشوائية لإيجاد كتل الاحتماليات
            multiplication_result = x_slice * tiled_pattern
            reshaped_matrix = multiplication_result.reshape(num_blocks, segment_len)
            
            block_sums = np.sum(reshaped_matrix, axis=1)
            block_probabilities = block_sums / segment_energy
            
            # قنص الكتل التي تتجاوز عتبة الاحتمالية المطلوبة
            matched_block_indices = np.where(block_probabilities >= similarity_threshold)[0]
            
            # استخراج وفك الإندكسات بدقة لتجنب أخطاء الـ TypeError
            for b_idx in matched_block_indices:
                actual_start_pos = int(shift + (b_idx * segment_len))
                actual_end_pos = int(actual_start_pos + segment_len)
                
                keep_mask[actual_start_pos:actual_end_pos] = False
                matched_positions.append(actual_start_pos / sr)
                
        # --- خطوة الحذف الفعلي والانكماش الديناميكي المتسارع ---
        if len(matched_positions) > 0:
            x = x[keep_mask] # قص الأنماط المتطابقة وانكماش بقية مصفوفة الصوت فوراً وضمه لبعضه
            
            unique_positions = sorted(list(set(matched_positions)))
            final_knowledge_base[cluster_name] = unique_positions
            
            shrinkage_percent = (1.0 - (len(x) / initial_length)) * 100
            
            if log_callback:
                log_callback(f"🎯 [تصفية {cluster_name}]: تم عزل المتطابقات وحذف مواقعها.")
                log_callback(f"📉 المصفوفة تنكمش متسارعة إلى: {len(x):,} سامبل (نسبة الغربلة: {shrinkage_percent:.2f}%).")
                log_callback("-" * 50)
                
            if result_callback:
                result_callback(cluster_name, len(unique_positions))
                
            cluster_counter += 1
        else:
            x = x[1:] # صمام الأمان لضمان استمرار التناقص والتتابع
            
    return final_knowledge_base
